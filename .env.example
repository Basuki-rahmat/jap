# ===== PRODUKSI: salin menjadi .env lalu isi nilai sebenarnya =====
# App
PORT=3000
NODE_ENV=production
# WAJIB: string acak panjang (min. 32 karakter), mis. hasil `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=ganti-dengan-secret-acak-min-32-karakter

# MySQL (buat user khusus aplikasi, JANGAN pakai root tanpa password)
DB_HOST=localhost
DB_USER=knabcoid_admin
DB_PASSWORD=ganti-dengan-password-kuat
DB_NAME=knabcoid_knab
DB_PORT=3306

# URL publik aplikasi (https + domain produksi, tanpa garis miring di akhir)
APP_URL=https://knab.co.id

# Email transaksional (autoresponder pendaftaran marketing, dari info@knab.co.id)
# Contoh cPanel: SMTP_HOST=mail.knab.co.id SMTP_PORT=465 SMTP_SECURE=true
# Contoh relay (Brevo/Mailgun/dll): ikuti host/port dari dashboard penyedia.
SMTP_HOST=mail.knab.co.id
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@knab.co.id
SMTP_PASS=ganti-dengan-password-email
MAIL_FROM=Sewa Lahan BSS <info@knab.co.id>
