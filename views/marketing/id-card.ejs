<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>ID Card Digital - <%= member.name %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/favicon.ico" />

    <style>
        * {
            box-sizing: border-box;
        }

        :root {
            --blue: #0b4385;
            --blue-dark: #0b376b;
            --gold: #c4931c;
            --gold-deep: #a87b12;
            --green: #42b72a;
            --ink: #12345b;
            --muted: #53657a;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: "Open Sans", Arial, Helvetica, sans-serif;
            color: var(--ink);
            background:
                radial-gradient(circle at 15% 15%, rgba(230, 181, 56, .16), transparent 30%),
                radial-gradient(circle at 85% 85%, rgba(0, 70, 145, .12), transparent 32%),
                linear-gradient(135deg, #f8fafc 0%, #ffffff 50%, #eef4fa 100%);
            background-attachment: fixed;
            padding: 0;
        }

        .page {
            width: min(100%, 600px);
            margin: 0 auto;
            padding: clamp(12px, 3vw, 24px) clamp(12px, 4vw, 20px) 40px;
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        /* ---------- Toolbar ---------- */
        .topbar {
            display: flex;
            gap: 10px;
            align-items: stretch;
        }

        .btn {
            border: none;
            padding: 13px 20px;
            border-radius: 16px;
            font-weight: 800;
            font-size: 15px;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: transform .15s ease, box-shadow .15s ease, filter .15s ease;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--blue), var(--blue-dark));
            color: #fff;
            flex: 1;
            box-shadow:
                0 12px 22px rgba(11, 55, 107, 0.35),
                inset 0 1px 0 rgba(255,255,255,0.25);
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            filter: brightness(1.05);
        }

        .btn-ghost {
            background: rgba(255,255,255,.9);
            color: var(--blue-dark);
            border: 2px solid var(--blue-dark);
            box-shadow: 0 8px 18px rgba(0,0,0,.08);
            white-space: nowrap;
        }

        .btn-ghost:hover {
            transform: translateY(-2px);
        }

        /* ---------- Preview panel ---------- */
        .preview {
            background: rgba(255,255,255,.85);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            border: 1px solid rgba(11,55,107,.10);
            border-radius: 24px;
            padding: clamp(16px, 4vw, 28px);
            box-shadow: 0 18px 40px rgba(20, 45, 80, .14);
        }

        .preview-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            margin-bottom: 14px;
        }

        .preview-title {
            font-size: 12px;
            font-weight: 800;
            letter-spacing: .12em;
            text-transform: uppercase;
            color: var(--muted);
        }

        .size-chip {
            font-size: 11px;
            font-weight: 800;
            color: var(--blue-dark);
            background: #f3f7fc;
            border: 1px solid #dce7f2;
            padding: 4px 10px;
            border-radius: 99px;
            white-space: nowrap;
        }

        .scaler {
            position: relative;
            width: 100%;
            overflow: hidden;
        }

        /* Kartu fisik: TETAP 54mm x 85.6mm persis (acuan cetak).
           Skala tampilan layar diatur via JS (#cardScaler). */
        .id-card {
            width: 54mm;
            height: 85.6mm;
            position: relative;
            overflow: hidden;
            border-radius: 5mm;
            background: #ffffff;
            box-shadow:
                0 30px 65px rgba(0, 0, 0, .26),
                0 12px 26px rgba(11, 55, 107, .20),
                inset 0 1px 0 rgba(255,255,255,.9);
            transform-origin: top left;
            border: .35mm solid rgba(255,255,255,.9);
        }

        .id-card::before {
            content: "";
            position: absolute;
            inset: 0;
            background:
                radial-gradient(circle at 14% 8%, rgba(255,255,255,.35), transparent 20%),
                radial-gradient(circle at 92% 12%, rgba(210,160,42,.45), transparent 22%),
                radial-gradient(circle at 10% 92%, rgba(255,255,255,.22), transparent 24%),
                linear-gradient(145deg, #0e4c92 0%, #0b376b 52%, #8f6c12 100%);
            z-index: 0;
        }

        .id-card::after {
            content: "KNAB";
            position: absolute;
            left: 50%;
            top: 50%;
            transform: translate(-50%, -50%) rotate(-90deg);
            font-size: 13mm;
            font-weight: 900;
            letter-spacing: 2.2mm;
            color: rgba(255,255,255,.09);
            z-index: 1;
        }

        .circle-a,
        .circle-b,
        .circle-c {
            position: absolute;
            border-radius: 50%;
            z-index: 1;
            background: rgba(255,255,255,.16);
        }

        .circle-a {
            width: 30mm;
            height: 30mm;
            right: -11mm;
            top: -10mm;
        }

        .circle-b {
            width: 24mm;
            height: 24mm;
            left: -9mm;
            bottom: -8mm;
        }

        .circle-c {
            width: 10mm;
            height: 10mm;
            right: 6mm;
            bottom: 22mm;
            background: rgba(210,160,42,.35);
        }

        .card-content {
            position: relative;
            z-index: 2;
            height: 100%;
            padding: 2.8mm;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .brand-row {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 2mm;
            margin-top: .4mm;
            margin-bottom: .8mm;
            text-align: center;
        }

        /* Box logo presisi: kotak tepat 6.5mm, logo contain penuh tanpa padding */
        .logo-box {
            width: 6.5mm;
            height: 6.5mm;
            border-radius: 1.6mm;
            background: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 1mm 2.4mm rgba(0,0,0,.14);
            overflow: hidden;
            flex-shrink: 0;
            padding: 0;
        }

        .logo-box img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            object-position: center;
            display: block;
        }

        .jp-fallback {
            font-size: 2mm;
            font-weight: 900;
            color: #0b376b;
        }

        .brand-text {
            color: #f7b132;
            font-size: 2.5mm;
            font-weight: 800;
            line-height: 1.1;
            white-space: nowrap;
            text-shadow: 0 .6mm 1.2mm rgba(0,0,0,.18);
        }

        .photo-wrap {
            margin-top: 1.6mm;
            width: 22.5mm;
            height: 25mm;
            border-radius: 3.8mm;
            background: #ffffff;
            padding: 0.28mm;
            box-shadow:
                0 2.6mm 7mm rgba(0,0,0,.24),
                inset 0 .15mm 0 rgba(255,255,255,.75);
            overflow: hidden;
            flex-shrink: 0;
        }

        .photo-inner {
            width: 100%;
            height: 100%;
            border-radius: 3.55mm;
            background-color: #e4e6eb;
            background-size: cover;
            background-position: center top;
            background-repeat: no-repeat;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #606770;
            font-size: 2mm;
            font-weight: 900;
            line-height: 1.25;
        }

        .position {
            margin-top: 1.6mm;
            display: inline-block;
            background: rgba(210,160,42,.30);
            border: .25mm solid rgba(255,255,255,.35);
            border-radius: 20mm;
            padding: 1mm 3mm;
            color: white;
            font-size: 2mm;
            font-weight: 900;
            letter-spacing: .12mm;
        }

        .name {
            margin-top: 1.2mm;
            color: white;
            font-size: 3.4mm;
            line-height: 1.08;
            font-weight: 900;
            text-transform: uppercase;
            text-shadow: 0 .8mm 1.7mm rgba(0,0,0,.18);
            max-height: 7.5mm;
            overflow: hidden;
            width: 100%;
            word-break: break-word;
        }

        .meta {
            margin-top: 1.2mm;
            width: 100%;
            display: grid;
            gap: .7mm;
        }

        .meta-row {
            background: rgba(255,255,255,.17);
            border: .22mm solid rgba(255,255,255,.18);
            border-radius: 2.3mm;
            padding: .8mm 1.35mm;
            color: white;
            font-size: 1.9mm;
            line-height: 1.14;
            display: grid;
            grid-template-columns: 12.5mm 1fr;
            gap: 1mm;
            text-align: left;
        }

        .meta-row span {
            opacity: .86;
            font-weight: 800;
            text-transform: uppercase;
        }

        .meta-row b {
            font-weight: 900;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .bottom {
            width: 100%;
            margin-top: auto;
            display: grid;
            grid-template-columns: 1fr auto;
            gap: 1.8mm;
            align-items: end;
            text-align: left;
        }

        .valid {
            color: white;
            font-size: 1.68mm;
            line-height: 1.27;
            opacity: .97;
        }

        /* QR anti-terpotong: anchor diberi dimensi penuh agar img 100% tidak kolaps */
        .qr {
            width: 11.5mm;
            height: 11.5mm;
            border-radius: 2.2mm;
            background: white;
            padding: .8mm;
            box-shadow: 0 1.7mm 4mm rgba(0,0,0,.2);
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            flex-shrink: 0;
        }

        .qr a {
            display: flex;
            width: 100%;
            height: 100%;
            align-items: center;
            justify-content: center;
        }

        .qr img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            display: block;
        }

        .qr-fallback {
            font-size: 1.45mm;
            text-align: center;
            color: #606770;
            line-height: 1.15;
            font-weight: 900;
        }

        /* ---------- Actions + hint ---------- */
        .actions {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .btn-block {
            width: 100%;
        }

        .hint {
            text-align: center;
            color: var(--muted);
            font-size: 13px;
            line-height: 1.7;
            background: rgba(255,255,255,.85);
            border: 1px solid rgba(255,255,255,.9);
            border-radius: 18px;
            padding: 14px 16px;
            box-shadow: 0 8px 18px rgba(0,0,0,.06);
        }

        .hint a {
            color: var(--blue-dark);
            font-weight: 800;
        }

        .verify-line {
            overflow-wrap: anywhere;
            font-size: 12px;
        }

        @media (min-width: 560px) {
            .actions {
                flex-direction: row;
            }

            .actions .btn {
                flex: 1;
            }
        }

        @page {
            size: 54mm 85.6mm;
            margin: 0;
        }

        @media print {
            html,
            body {
                width: 54mm !important;
                height: 85.6mm !important;
                min-height: 85.6mm !important;
                margin: 0 !important;
                padding: 0 !important;
                background: #ffffff !important;
                overflow: hidden !important;
            }

            .topbar,
            .preview-head,
            .actions,
            .hint {
                display: none !important;
            }

            .page {
                width: 54mm !important;
                max-width: none !important;
                margin: 0 !important;
                padding: 0 !important;
                display: block !important;
            }

            .preview {
                background: none !important;
                border: none !important;
                border-radius: 0 !important;
                box-shadow: none !important;
                padding: 0 !important;
            }

            .scaler {
                height: auto !important;
                overflow: visible !important;
            }

            .id-card {
                border-radius: 0 !important;
                box-shadow: none !important;
                border: none !important;
                transform: none !important;
                margin: 0 !important;
                page-break-inside: avoid !important;
                print-color-adjust: exact !important;
                -webkit-print-color-adjust: exact !important;
            }

            .photo-inner,
            .id-card,
            .id-card::before,
            .id-card::after {
                print-color-adjust: exact !important;
                -webkit-print-color-adjust: exact !important;
            }
        }
    </style>
</head>
<body>

    <div class="page">

        <div class="topbar">
            <a class="btn btn-ghost" href="/marketing">← Dashboard</a>
            <button class="btn btn-primary" onclick="window.print()">🖨️ Cetak</button>
        </div>

        <div class="preview">
            <div class="preview-head">
                <span class="preview-title">Pratinjau ID Card</span>
                <span class="size-chip">54 × 85,6 mm</span>
            </div>
            <div class="scaler" id="cardScaler">
                <div class="id-card" id="idCard">

                    <div class="circle-a"></div>
                    <div class="circle-b"></div>
                    <div class="circle-c"></div>

                    <div class="card-content">

                        <div class="brand-row">
                        <div class="logo-box">
                            <img src="<%= typeof brandLogo !== 'undefined' ? brandLogo : '/img/logo.png' %>" alt="Logo" onerror="this.outerHTML='<span class=jp-fallback>JP</span>'" />
                        </div>

                            <div class="brand-text"><%= brandName %></div>
                        </div>

                        <div class="photo-wrap">
                            <% if (member.photo_file) { %>
                                <div class="photo-inner" style="background-image:url('<%= member.photo_file %>');"></div>
                            <% } else { %>
                                <div class="photo-inner">FOTO<br/>BELUM ADA</div>
                            <% } %>
                        </div>

                        <div class="position"><%= position %></div>

                        <div class="name"><%= member.name %></div>

                        <div class="meta">
                            <div class="meta-row">
                                <span>ID</span>
                                <b><%= memberCode %></b>
                            </div>

                            <div class="meta-row">
                                <span>Nama</span>
                                <b><%= member.name %></b>
                            </div>

                            <div class="meta-row">
                                <span>Phone</span>
                                <b><%= member.whatsapp || '-' %></b>
                            </div>

                            <div class="meta-row">
                                <span>Wilayah</span>
                                <b><%= member.wilayah || '-' %></b>
                            </div>
                        </div>

                        <div class="bottom">
                            <div class="valid">
                                Terbit: <%= member.created_at ? new Date(member.created_at).toLocaleDateString('id-ID', { day: '2-digit', month: '2-digit', year: 'numeric' }) : '-' %><br />
                                <br />
                            </div>

                            <div class="qr">
                                <% if (qrDataUrl) { %>
                                    <a href="<%= verifyUrl %>" target="_blank" rel="noopener">
                                        <img src="<%= qrDataUrl %>" alt="QR Verifikasi" />
                                    </a>
                                <% } else { %>
                                    <span class="qr-fallback">SCAN<br/>GAGAL</span>
                                <% } %>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <div class="actions">
            <button class="btn btn-primary btn-block" onclick="window.print()">⬇️ Download / Cetak PDF</button>
            <% if (!member.photo_file || !member.wilayah) { %>
                <a class="btn btn-ghost btn-block" href="/marketing/profil">✏️ Lengkapi Profil</a>
            <% } %>
        </div>

        <div class="hint">
            <% if (!member.photo_file) { %>
                Foto belum ada — <a href="/marketing/profil">upload foto di Profil</a> agar tercetak di kartu.<br />
            <% } %>
            <% if (!member.wilayah) { %>
                Wilayah belum diisi — <a href="/marketing/profil">isi di Profil</a>.<br />
            <% } %>
            Pilih <b>Save as PDF</b> saat cetak — ukuran otomatis <b>54mm x 85.6mm portrait</b>.
            <div class="verify-line">QR → <b><%= verifyUrl %></b></div>
        </div>

    </div>

    <script>
        // Skala kartu 54mm agar pas dengan lebar layar (ponsel/desktop),
        // tanpa mengubah ukuran fisik kartu untuk cetak.
        (function () {
            var MM_TO_PX = 96 / 25.4;
            var card = document.getElementById('idCard');
            var wrap = document.getElementById('cardScaler');
            function fit() {
                if (!card || !wrap) return;
                var avail = wrap.clientWidth;
                if (!avail) return;
                var s = Math.min(avail / (54 * MM_TO_PX), 2.4);
                card.style.transform = 'scale(' + s + ')';
                wrap.style.height = (85.6 * MM_TO_PX * s) + 'px';
            }
            window.addEventListener('resize', fit);
            window.addEventListener('orientationchange', fit);
            if (document.fonts && document.fonts.ready) {
                try { document.fonts.ready.then(fit); } catch (e) {}
            }
            fit();
            setTimeout(fit, 300);
        })();
    </script>

</body>
</html>
