<%- include('../partials/head', { title: 'Jaringan Saya - BSS' }) %>
<%- include('../partials/dashNavbar') %>

<style>
  .net-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-bottom: 16px; }
  .net-stat { background: var(--card); border: 1px solid var(--card-border); border-radius: var(--radius); padding: 12px 14px; }
  .net-stat .num { font-size: 1.4rem; font-weight: 800; }
  .net-stat .lbl { font-size: .74rem; color: var(--muted, #888); }
  .net-search { margin-bottom: 12px; }
  .net-search input { width: 100%; max-width: 420px; padding: 9px 14px; border-radius: 999px; border: 1px solid var(--card-border); background: var(--card); color: var(--text); font-size: .85rem; }
  .lvl-badge { display: inline-block; font-size: .7rem; font-weight: 800; border-radius: 99px; padding: 2px 10px; background: var(--bg-soft); border: 1px solid var(--card-border); color: var(--primary); white-space: nowrap; }
  .net-indent { color: var(--muted, #aaa); }
  .net-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px; }
  .net-card { background: var(--card); border: 1px solid var(--card-border); border-left: 4px solid var(--primary); border-radius: 16px; padding: 14px; display: grid; gap: 10px; transition: transform .15s ease, box-shadow .15s ease; }
  .net-card:hover { transform: translateY(-2px); box-shadow: var(--shadow); }
  .net-card.lvl-2 { border-left-color: #3a93e8; }
  .net-card.lvl-3 { border-left-color: #9b59b6; }
  .net-top { display: flex; gap: 10px; align-items: center; min-width: 0; }
  .net-ava { width: 42px; height: 42px; flex: 0 0 42px; border-radius: 50%; background: linear-gradient(135deg, var(--primary), #3a93e8); color: #fff; font-weight: 800; display: flex; align-items: center; justify-content: center; font-size: .9rem; }
  .net-card.lvl-2 .net-ava { background: linear-gradient(135deg, #3a93e8, #8e44ad); }
  .net-card.lvl-3 .net-ava { background: linear-gradient(135deg, #9b59b6, #e67e22); }
  .net-id { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 1px; overflow-wrap: anywhere; }
  .net-nums { display: grid; grid-template-columns: 1fr 1fr; background: var(--bg-soft); border: 1px solid var(--card-border); border-radius: 12px; padding: 8px 4px; text-align: center; }
  .net-nums b { display: block; font-size: 1.05rem; line-height: 1.2; }
  .net-nums span { font-size: .6rem; font-weight: 700; color: var(--muted, #888); text-transform: uppercase; letter-spacing: .05em; }
  .net-foot { display: flex; justify-content: space-between; align-items: center; gap: 8px; font-size: .72rem; color: var(--muted, #888); }
  @media (max-width: 640px) { .net-stats { grid-template-columns: repeat(2, 1fr); } }
</style>

<main>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Halo, <%= me.name %></span>
        <h2>Jaringan Saya</h2>
        <p>Semua marketing di bawah Anda, langsung maupun tidak langsung.</p>
      </div>

      <% if (flash && flash.message) { %>
        <div class="alert alert-<%= flash.type %>"><%= flash.message %></div>
      <% } %>

      <div class="net-stats">
        <div class="net-stat"><div class="num"><%= totalCount %></div><div class="lbl">👥 Total Jaringan</div></div>
        <div class="net-stat"><div class="num"><%= directCount %></div><div class="lbl">↳ Langsung di bawah Anda</div></div>
        <div class="net-stat"><div class="num"><%= netLands %></div><div class="lbl">📋 Lahan jaringan</div></div>
        <div class="net-stat"><div class="num"><%= netApproved %></div><div class="lbl">✅ Disetujui jaringan</div></div>
      </div>

      <div class="card">
        <div class="card-title-row" style="margin-bottom:12px;">
          <h3 style="margin:0;">Daftar Marketing (<%= totalCount %>)</h3>
          <a href="/marketing" class="btn btn-outline" style="margin-left:auto;padding:8px 16px;font-size:.75rem;">← Dashboard</a>
        </div>
        <div class="net-search">
          <input type="search" id="netSearch" placeholder="🔍 Cari nama / email / referral…" />
        </div>
        <% if (tree.length === 0) { %>
          <p class="empty-cell" style="margin:0;">Belum ada marketing di bawah Anda. Minta admin menetapkan Anda sebagai Head saat menambah marketing baru.</p>
        <% } else { %>
          <div class="net-grid" id="netBody">
            <% tree.forEach(function (n) { %>
              <% var st = landStats[n.user.id] || { total: 0, approved: 0 }; %>
              <% var lv = Math.min(n.level, 3); %>
              <div class="net-card lvl-<%= lv %>" data-search="<%= (n.user.name + ' ' + n.user.email + ' ' + (n.user.referral_code || '')).toLowerCase() %>">
                <div class="net-top">
                  <span class="net-ava"><%= n.user.name.trim().split(/\s+/).map(function (w) { return w[0]; }).slice(0, 2).join('').toUpperCase() %></span>
                  <div class="net-id">
                    <strong><%= n.level > 1 ? '↳ ' : '' %><%= n.user.name %></strong>
                    <span class="subtext"><%= n.user.email %></span>
                  </div>
                  <span class="lvl-badge">Lv <%= n.level %></span>
                </div>
                <div class="net-nums">
                  <div><b><%= st.total %></b><span>📋 Lahan</span></div>
                  <div><b><%= st.approved %></b><span>✅ Disetujui</span></div>
                </div>
                <div class="net-foot">
                  <span><code><%= n.user.referral_code || '-' %></code></span>
                  <span>Gabung <%= n.user.created_at ? new Date(n.user.created_at).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' }) : '-' %></span>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  </section>
</main>

<script>
  (function () {
    var input = document.getElementById('netSearch');
    if (!input) return;
    var rows = Array.prototype.slice.call(document.querySelectorAll('#netBody .net-card'));
    input.addEventListener('input', function () {
      var q = input.value.trim().toLowerCase();
      rows.forEach(function (r) {
        r.style.display = (!q || (r.getAttribute('data-search') || '').indexOf(q) !== -1) ? '' : 'none';
      });
    });
  })();
</script>

<%- include('../partials/foot') %>
