<%- include('../partials/head', { title: 'Profil Saya - BSS' }) %>
<%- include('../partials/dashNavbar') %>

<main>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Halo, <%= me.name %></span>
        <h2>Profil Saya</h2>
        <p>Ubah nama dan WhatsApp akun admin Anda. Email &amp; role hanya bisa diubah superadmin.</p>
      </div>

      <% if (flash && flash.message) { %>
        <div class="alert alert-<%= flash.type %>"><%= flash.message %></div>
      <% } %>

      <div class="card" style="max-width:560px;margin-inline:auto;">
        <form action="/admin/profil" method="POST">
          <div class="form-group">
            <label for="profil_name">Nama Lengkap</label>
            <input class="form-control" type="text" id="profil_name" name="name" required autocomplete="off" value="<%= me.name %>" />
          </div>
          <div class="form-group">
            <label for="profil_email">Email (login)</label>
            <input class="form-control" type="email" id="profil_email" value="<%= me.email %>" disabled />
            <p class="form-hint">Email tidak bisa diubah sendiri.</p>
          </div>
          <div class="form-group">
            <label for="profil_wa">No. WhatsApp</label>
            <input class="form-control" type="text" id="profil_wa" name="whatsapp" autocomplete="off" value="<%= me.whatsapp || '' %>" placeholder="08xx" />
          </div>
          <div class="form-group">
            <label>Role</label>
            <div><span class="badge <%= me.role === 'superadmin' ? 'badge-approved' : 'badge-pending' %>"><%= me.role === 'superadmin' ? 'SUPERADMIN' : 'ADMIN' %></span></div>
          </div>
          <button type="submit" class="btn btn-accent btn-block"><strong>Simpan Profil</strong></button>
        </form>
        <p class="text-center" style="margin-top:12px;font-size:.86rem;">
          <a href="/admin/password">Ganti password →</a>
        </p>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/foot') %>
