<%- include('../partials/head', { title: 'Perangkat Dikenal - BSS' }) %>
<%- include('../partials/dashNavbar') %>

<style>
  .dev-wrap { max-width: 720px; margin-inline: auto; display: grid; gap: 10px; }
  .dev-item { background: var(--card); border: 1px solid var(--card-border); border-radius: 14px; padding: 13px 15px; }
  .dev-item.current { border-left: 4px solid var(--primary); background: var(--primary-soft); }
  .dev-item .t { font-weight: 800; font-size: .9rem; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .dev-item .b { font-size: .8rem; color: var(--muted, #888); margin-top: 4px; line-height: 1.6; word-break: break-all; }
  .dev-item .d { font-size: .7rem; color: var(--muted, #888); margin-top: 6px; }
  .pill { font-size: .68rem; font-weight: 800; border-radius: 99px; padding: 2px 10px; border: 1px solid var(--card-border); background: var(--card); }
  .pill.ok { background: rgba(25,135,84,.12); color: #146c43; border-color: rgba(25,135,84,.3); }
  .dev-actions { display: flex; gap: 8px; margin-top: 10px; }
  .dev-empty { text-align: center; color: var(--muted, #888); padding: 34px 16px; background: var(--card); border: 1px dashed var(--card-border); border-radius: 14px; }
</style>

<main>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Keamanan Akun</span>
        <h2>Perangkat Dikenal</h2>
        <p>Setiap login dari perangkat baru memicu email peringatan. Hapus perangkat agar login berikutnya dari sana memicu email lagi.</p>
      </div>

      <div class="dev-wrap">
        <div style="display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap;">
          <a href="<%= back %>" class="btn btn-outline" style="text-decoration:none;padding:7px 14px;font-size:.78rem;">← Dashboard</a>
          <% if (devices.length > 1) { %>
            <form action="/perangkat/lupakan-lainnya" method="POST" onsubmit="return confirm('Lupakan semua perangkat lain?');">
              <button type="submit" class="btn btn-outline" style="padding:7px 14px;font-size:.78rem;">Lupakan perangkat lain</button>
            </form>
          <% } %>
        </div>

        <% if (flash && flash.message) { %>
          <div class="alert alert-<%= flash.type %>"><%= flash.message %></div>
        <% } %>

        <% if (missingTable) { %>
          <div class="alert alert-error">Tabel <code>user_devices</code> belum ada di database. Jalankan <code>node config/upgradeDb.js</code> di server / import <code>config/upgradeHosting.sql</code>, lalu refresh.</div>
        <% } else if (devices.length === 0) { %>
          <div class="dev-empty">📱 Belum ada perangkat tercatat. Login ulang sekali agar perangkat ini terdaftar.</div>
        <% } else { %>
          <% devices.forEach(function (d) { %>
            <div class="dev-item <%= currentId && Number(d.id) === Number(currentId) ? 'current' : '' %>">
              <div class="t">
                📱 <%= d.device_name ? d.device_name : 'Browser / Aplikasi' %>
                <% if (currentId && Number(d.id) === Number(currentId)) { %>
                  <span class="pill ok">Perangkat ini</span>
                <% } %>
              </div>
              <div class="b">
                IP terakhir: <strong><%= d.last_ip || '-' %></strong><br />
                <span><%= d.user_agent ? String(d.user_agent).slice(0, 200) : '-' %></span>
              </div>
              <div class="d">
                Pertama: <%= d.first_seen ? new Date(d.first_seen).toLocaleString('id-ID', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '-' %>
                &nbsp;•&nbsp; Terakhir aktif: <%= d.last_seen ? new Date(d.last_seen).toLocaleString('id-ID', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '-' %>
              </div>
              <div class="dev-actions">
                <form action="/perangkat/hapus" method="POST" onsubmit="return confirm('Lupakan perangkat ini? Login berikutnya dari sana akan memicu email lagi.');">
                  <input type="hidden" name="id" value="<%= d.id %>" />
                  <button type="submit" class="btn btn-outline" style="padding:6px 14px;font-size:.78rem;">🗑 Lupakan</button>
                </form>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/foot') %>
