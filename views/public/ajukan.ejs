<script>
  // 1) Referral: URL > sessionStorage (tetap seperti sebelumnya)
  (function () {
    var urlRef = new URLSearchParams(window.location.search).get('ref');
    var ref = '';
    if (urlRef && urlRef.trim()) {
      ref = urlRef.trim();
      try { sessionStorage.setItem('jap_ref', ref); } catch (e) {}
    } else {
      try { ref = sessionStorage.getItem('jap_ref') || ''; } catch (e) { ref = ''; }
    }
    if (ref) {
      var input = document.getElementById('referral_code');
      if (input) input.value = ref;
      var note = document.querySelector('.referral-note');
      if (!note) {
        note = document.createElement('div');
        note.className = 'referral-note';
        var head = document.querySelector('.section-head');
        if (head) head.insertAdjacentElement('afterend', note);
      }
      if (note) {
        note.style.display = 'block';
        note.innerHTML = '🔗 Pengajuan terhubung dengan : <strong>' + ref.replace(/</g, '&lt;') + '</strong>';
      }
      if (!urlRef && ref) {
        history.replaceState(null, '', '/ajukan?ref=' + encodeURIComponent(ref));
      }
    }
  })();

  // 2) GPS → alamat otomatis (tetap bisa diketik manual)
  // Dipanggil dari location-map.js setiap pin/GPS berubah, dan dari tombol tahap 1.
  // Alamat pemilik (Tahap 1) vs alamat lokasi (Tahap 3) dipisah.
  // location-map.js memanggil dengan target 'map' -> isi alamat LOKASI + kota & kelurahan;
  // tombol GPS Tahap 1 / posisi manual -> isi alamat PEMILIK.
  // Helper ala referensi Japripay System.html:
  function cleanCityName(cityName) {
    if (!cityName) return '';
    var clean = String(cityName).trim();
    if (/\s+Regency$/i.test(clean)) clean = 'Kab. ' + clean.replace(/\s+Regency$/i, '');
    else {
      clean = clean.replace(/^Kota\s+/i, '').replace(/^Kabupaten\s+/i, 'Kab. ').replace(/\s+City$/i, '');
    }
    return clean.trim();
  }
  function cleanWardName(s, prefixRe) {
    return String(s || '').replace(prefixRe, '').trim();
  }
  window._japAutofillAddress = function (lat, lng, target, force) {
    var isLoc = target === 'map';
    var addrInput = document.getElementById(isLoc ? 'location_address' : 'address');
    var addrStatus = document.getElementById(isLoc ? 'locAddrStatus' : 'addrStatus');
    if (!addrInput) return;
    if (addrStatus) addrStatus.textContent = '⏳ Mencari alamat dari koordinat…';
    // Via proxy server sendiri (/api/reverse) agar tidak kena blokir CORS / 429 Nominatim dari browser.
    fetch('/api/reverse?lat=' + encodeURIComponent(lat) + '&lon=' + encodeURIComponent(lng))
      .then(function (r) { if (!r.ok) throw new Error('geo ' + r.status); return r.json(); })
      .then(function (j) {
        var label = (typeof window._japFormatAddressNominatim === 'function' ? window._japFormatAddressNominatim(j) : '') || (j && j.display_name) || '';
        var addr = (j && j.address) || {};
        // Kab/kota, kecamatan & kelurahan langsung dari pin (hanya tahap lokasi)
        if (isLoc && addr) {
          try {
            var fillText = function (id, val) {
              var el = document.getElementById(id);
              if (!el || !val) return;
              el.value = val;
              try { el.dispatchEvent(new Event('input', { bubbles: true })); } catch (e) {}
            };
            var kotaRaw = addr.regency || addr.county || addr.city || addr.town || addr.municipality || '';
            if (kotaRaw) fillText('city', cleanCityName(kotaRaw));
            var kecRaw = addr.city_district || addr.district || addr.subdistrict || addr.borough || addr.town || '';
            fillText('kecamatan', cleanWardName(kecRaw, /^(Kecamatan|Kec\.?)\s+/i));
            var kelRaw = addr.village || addr.quarter || addr.neighbourhood || addr.hamlet || addr.suburb || '';
            fillText('district', cleanWardName(kelRaw, /^(Kelurahan|Desa|Kel\.?)\s+/i));
          } catch (e) {}
        }
        if (!label) {
          if (addrStatus) addrStatus.textContent = 'Koordinat didapat, tetapi alamat tidak ditemukan — silakan ketik manual.';
          return;
        }
        if (!addrInput.value.trim() || force === true || isLoc) {
          var overwritten = !!addrInput.value.trim() && (force === true || isLoc);
          addrInput.value = label;
          try { addrInput.dispatchEvent(new Event('input', { bubbles: true })); } catch (e) {}
          if (addrStatus) addrStatus.textContent = overwritten
            ? '✓ Alamat ' + (isLoc ? 'lokasi diperbarui mengikuti pin peta' : 'pemilik') + ' ditimpa otomatis — tetap bisa diubah manual.'
            : '✓ Alamat ' + (isLoc ? 'lokasi' : 'pemilik') + ' terisi otomatis dari GPS — boleh diubah manual.';
        } else if (addrStatus) {
          addrStatus.textContent = '✓ GPS aktif. Alamat baru terdeteksi — kolom tidak ditimpa karena sudah diisi manual.';
        }
      })
      .catch(function () {
        if (addrStatus) addrStatus.textContent = 'Gagal mengambil alamat otomatis (jaringan) — silakan ketik manual.';
      });
  };

  // 2b) Pola referensi: format No HP 08→628, NIK numeric-only, harga dinamis, validasi nama toko, koordinat
  (function () {
    var phoneEl = document.getElementById('phone_number');
    if (phoneEl) {
      phoneEl.addEventListener('input', function () {
        var v = this.value.replace(/\D/g, '');
        if (v.indexOf('08') === 0) v = '628' + v.substring(2);
        this.value = v;
      });
    }
    var nikEl = document.getElementById('nik');
    if (nikEl) {
      nikEl.addEventListener('input', function () { this.value = this.value.replace(/[^0-9]/g, '').slice(0, 16); });
    }
    var rekEl = document.getElementById('account_number');
    if (rekEl) {
      rekEl.addEventListener('input', function () { this.value = this.value.replace(/[^0-9]/g, '').slice(0, 20); });
    }
    var hargaEls = document.querySelectorAll('.harga-dual');
    if (hargaEls && hargaEls.length) {
      // Format ribu otomatis ala 3.000.000 saat ketik; server menyimpan digit murni.
      Array.prototype.forEach.call(hargaEls, function (he) {
        he.addEventListener('input', function () {
          var d = this.value.replace(/\D/g, '').slice(0, 12);
          this.value = d ? d.replace(/\B(?=(\d{3})+(?!\d))/g, '.') : '';
        });
      });
    }
    // Harga sewa per tipe (keduanya opsional, boleh kosong, diisi admin)
    window._japRefreshHarga = function () {
      var hb = document.getElementById('harga_sewa_bss');
      var he = document.getElementById('harga_sewa_evcs');
      if (hb) {
        hb.placeholder = 'Contoh: 3.000.000 (boleh kosong)';
        try { hb.setCustomValidity(''); } catch (e) {}
      }
      if (he) {
        he.placeholder = 'Contoh: 6.000.000 (boleh kosong)';
        try { he.setCustomValidity(''); } catch (e) {}
      }
    };
    // Nilai jenis unit: checkbox multi (ajukan) atau radio/select (kompatibel lama)
    window._japGetUnitTypes = function () {
      var out = [];
      Array.prototype.forEach.call(document.querySelectorAll('input[name="unit_type"]:checked'), function (r) {
        if (r.value === 'bss_motor' || r.value === 'evcs_mobil') out.push(r.value);
      });
      if (out.length) return out;
      var sel = document.getElementById('unit_type');
      if (sel && (sel.value === 'bss_motor' || sel.value === 'evcs_mobil')) return [sel.value];
      return [];
    };
    window._japGetUnitType = function () {
      var list = window._japGetUnitTypes();
      return list.length ? list[0] : 'bss_motor';
    };
    var unitEl = document.getElementById('unit_type');
    // Kolom slot aktif mengikuti unit yang dicentang (boleh keduanya)
    function paintSlotCols() {
      var list = window._japGetUnitTypes();
      var cb = document.getElementById('slotColBss');
      var ce = document.getElementById('slotColEvcs');
      if (cb) cb.classList.toggle('active', list.indexOf('bss_motor') !== -1);
      if (ce) ce.classList.toggle('active', list.indexOf('evcs_mobil') !== -1);
    }
    // Bangun grid slot sekali (BSS 1-4 | EVCS 1-4); pilihan dipertahankan
    function buildSlotGrids() {
      var defs = [['slotGridBss', 'BSS', 'slot_bss', 'bss_motor'], ['slotGridEvcs', 'EVCS', 'slot_evcs', 'evcs_mobil']];
      defs.forEach(function (d) {
        var grid = document.getElementById(d[0]);
        if (!grid || grid.getAttribute('data-built') === '1') return;
        grid.setAttribute('data-built', '1');
        for (var i = 1; i <= 4; i++) {
          (function (val, fname, uval) {
            var lab = document.createElement('label');
            lab.className = 'slot-card';
            var inp = document.createElement('input');
            inp.type = 'radio';
            inp.name = fname;
            inp.value = String(val);
            inp.addEventListener('change', function () {
              // Pilih slot = ikut centang jenis unit kolomnya
              var ur = document.querySelector('input[name="unit_type"][value="' + uval + '"]');
              if (ur && (ur.type !== 'checkbox' || !ur.checked)) {
                ur.checked = true;
                try { ur.dispatchEvent(new Event('change', { bubbles: true })); } catch (e) {}
              }
              try { window._japRefreshHarga(); } catch (e) {}
              try { paintSlotCols(); } catch (e) {}
            });
            var sp = document.createElement('span');
            sp.textContent = String(val);
            lab.appendChild(inp);
            lab.appendChild(sp);
            grid.appendChild(lab);
          })(i, d[2], d[3]);
        }
      });
    }
    // Legalitas + hint mengikuti unit tercentang (server memaksa per unit saat simpan)
    window._japRefreshSlot = function () {
      try { paintSlotCols(); } catch (e) {}
      var list = window._japGetUnitTypes();
      var onlyEvcs = list.length === 1 && list[0] === 'evcs_mobil';
      var leg = document.getElementById('legal_doc_type');
      if (leg) {
        leg.value = onlyEvcs ? 'shm' : 'pbb';
        try { leg.dispatchEvent(new Event('change', { bubbles: true })); } catch (e) {}
      }
      var legNote = document.getElementById('legalAutoNote');
      if (legNote) legNote.textContent = !list.length
        ? 'Centang minimal satu jenis unit.'
        : (list.length === 2
          ? 'Otomatis per unit: BSS → PBB (3 tahun + bukti bayar), EVCS → SHM.'
          : (onlyEvcs ? 'Otomatis: EVCS wajib SHM.' : 'Otomatis: BSS memakai PBB (3 tahun terakhir + bukti bayar).'));
      var hint = document.getElementById('slotHint');
      if (hint) hint.textContent = !list.length
        ? 'Centang BSS / EVCS lalu pilih slotnya.'
        : (list.length === 2
          ? 'BSS + EVCS dipilih — pilih Slot BSS dan Slot EVCS (2 unit terkirim sekaligus).'
          : (onlyEvcs ? 'Jenis EVCS — pilih Slot EVCS 1 sampai 4.' : 'Jenis BSS — pilih Slot BSS 1 sampai 4.'));
    };
    if (unitEl) {
      unitEl.addEventListener('change', function () { try { window._japRefreshHarga(); } catch (e) {} try { window._japRefreshSlot(); } catch (e) {} });
      try { window._japRefreshHarga(); } catch (e) {}
      try { window._japRefreshSlot(); } catch (e) {}
    }
    Array.prototype.forEach.call(document.querySelectorAll('input[name="unit_type"]'), function (r) {
      r.addEventListener('change', function () { try { window._japRefreshHarga(); } catch (e) {} try { window._japRefreshSlot(); } catch (e) {} });
    });
    try { buildSlotGrids(); } catch (e) {}
    try { window._japRefreshHarga(); } catch (e) {}
    try { window._japRefreshSlot(); } catch (e) {}
    try { paintSlotCols(); } catch (e) {}
    // Validasi nama toko ala referensi
    var foodKeywords = ['makan', 'padang', 'ayam', 'soto', 'bakso', 'nasi', 'goreng',
      'seafood', 'steak', 'pizza', 'pasta', 'mie', 'bebek', 'ikan',
      'udang', 'cumi', 'pecel', 'rawon', 'rendang', 'sate', 'gado'];
    window._japCheckShopName = function (text) {
      var lower = String(text || '').toLowerCase().trim();
      if (!lower) return { forbidden: false };
      if (lower.indexOf('pribadi') !== -1) return { forbidden: true, reason: 'pribadi' };
      if (lower.indexOf('rumah') !== -1) {
        if (lower.indexOf('rumah makan') !== -1) return { forbidden: false };
        return { forbidden: true, reason: 'rumah' };
      }
      if (lower.indexOf('rmh') !== -1) return { forbidden: true, reason: 'rmh' };
      if (lower.indexOf('rm') !== -1) {
        var words = lower.split(/\s+/);
        var isFood = false, isStandalone = false;
        for (var i = 0; i < words.length; i++) {
          if (words[i] === 'rm') {
            var next = words[i + 1] || '';
            if (foodKeywords.some(function (f) { return next.indexOf(f) !== -1; })) isFood = true;
            else isStandalone = true;
          }
        }
        if (isFood) return { forbidden: false };
        if (isStandalone || lower === 'rm') return { forbidden: true, reason: 'rm' };
        if (lower.indexOf('rm ') === 0 && !isFood) return { forbidden: true, reason: 'rm' };
      }
      return { forbidden: false };
    };
    var shopEl = document.getElementById('shop_name');
    var shopAlert = document.getElementById('shopNameAlert');
    function paintShop() {
      if (!shopEl) return true;
      var r = window._japCheckShopName(shopEl.value);
      if (r.forbidden && shopEl.value.length > 0) {
        if (shopAlert) shopAlert.classList.add('show');
        shopEl.style.borderColor = '#ef4444';
        shopEl.setCustomValidity('Nama toko mengandung kata terlarang.');
        return false;
      }
      if (shopAlert) shopAlert.classList.remove('show');
      shopEl.style.borderColor = '';
      shopEl.setCustomValidity('');
      return true;
    }
    if (shopEl) {
      shopEl.addEventListener('input', paintShop);
      try { paintShop(); } catch (e) {}
    }
    window._japValidateShop = paintShop;
    // Koordinat terlihat: validasi format + sinkron 2 arah dengan pin peta
    var latEl = document.getElementById('input_lat_long');
    var errEl = document.getElementById('error_msg');
    function paintCoord(msg, cls, borderCls) {
      if (errEl) {
        errEl.textContent = msg;
        errEl.className = 'loc-status ' + cls;
      }
      if (latEl) {
        latEl.classList.remove('coord-ok', 'coord-bad', 'coord-err');
        if (borderCls) latEl.classList.add(borderCls);
      }
    }
    if (latEl) {
      latEl.addEventListener('input', function () {
        var v = latEl.value;
        if (/[^0-9.,\-\s]/.test(v)) {
          paintCoord('* Input tidak menerima huruf! Gunakan format koordinat angka', 'muted-text', 'coord-err');
          latEl.value = v.replace(/[^0-9.,\-\s]/g, '');
          latEl.setCustomValidity('Format koordinat salah.');
          return;
        }
        var re = /^-?\d+(\.\d+)?,\s*-?\d+(\.\d+)?$/;
        if (v.trim() === '') {
          paintCoord('* Masukkan angka dipisahkan koma', 'muted-text', '');
          latEl.setCustomValidity('Koordinat wajib diisi.');
        } else if (!re.test(v)) {
          paintCoord('* Format belum sesuai contoh: -6.200000, 106.816666', 'muted-text', 'coord-bad');
          latEl.setCustomValidity('Format koordinat belum benar.');
        } else {
          paintCoord('* Format Koordinat Benar!', 'muted-text', 'coord-ok');
          latEl.setCustomValidity('');
          var parts = v.split(',');
          var la = parseFloat(parts[0]), ln = parseFloat(parts[1]);
          if (isFinite(la) && isFinite(ln) && typeof window._japSetMapPin === 'function') {
            try { window._japSetMapPin(la, ln); } catch (e) {}
          }
        }
      });
    }
    window._japSyncLatFromMaps = function (mapsVal) {
      if (!latEl || !mapsVal) return;
      if (latEl.value.trim()) return; // jangan timpa ketikan manual
      var m = String(mapsVal).match(/q=(-?\d+(?:\.\d+)?),(-?\d+(?:\.\d+)?)/);
      if (m) {
        latEl.value = parseFloat(m[1]).toFixed(6) + ', ' + parseFloat(m[2]).toFixed(6);
        try { latEl.dispatchEvent(new Event('input', { bubbles: true })); } catch (e) {}
      }
    };
    // Tombol kalibrasi ala referensi: paksa GPS akurasi tinggi lalu pasang pin
    var btnCal = document.getElementById('btnRecalibrate');
    if (btnCal) {
      btnCal.addEventListener('click', function () {
        var st = document.getElementById('locStatus');
        if (!navigator.geolocation) {
          if (st) st.textContent = 'Perangkat tidak mendukung GPS — klik manual pada peta.';
          return;
        }
        if (st) st.textContent = '📡 Kalibrasi lokasi — mohon izinkan akses lokasi…';
        navigator.geolocation.getCurrentPosition(function (pos) {
          var la = pos.coords.latitude, ln = pos.coords.longitude;
          if (typeof window._japSetMapPin === 'function') {
            try { window._japSetMapPin(la, ln); } catch (e) {}
          } else {
            var g = document.getElementById('btnGps');
            if (g) try { g.click(); } catch (e) {}
          }
          if (st) st.textContent = '📍 Kalibrasi berhasil: ' + la.toFixed(6) + ',' + ln.toFixed(6);
        }, function (err) {
          if (st) st.textContent = 'Gagal melacak lokasi akurat (' + (err.message || 'izin ditolak') + '). Gunakan penyesuaian manual.';
        }, { enableHighAccuracy: true, timeout: 12000, maximumAge: 0 });
      });
    }
  })();

  // 2) Wizard + draft localStorage (teks saja; file tidak bisa disimpan browser)
  (function () {
    var DRAFT_KEY = 'jap_ajukan_draft_v1';
    var STEP_KEY = 'jap_ajukan_step_v1';
    var TEXT_FIELDS = ['owner_name', 'phone_number', 'address', 'nik', 'ttl', 'surat', 'shop_name', 'city', 'kecamatan', 'district', 'harga_sewa_bss', 'harga_sewa_evcs', 'bank_name', 'bank_name_other', 'account_number', 'location_address', 'area_size', 'location_type', 'floor_ready', 'has_canopy', 'legal_doc_type', 'maps_link', 'lat_long', 'maps_url'];
    var form = document.getElementById('ajukanForm');
    if (!form) return;
    var steps = Array.prototype.slice.call(form.querySelectorAll('.wizard-step'));
    var stepItems = Array.prototype.slice.call(document.querySelectorAll('#wizardSteps li'));
    var bar = document.getElementById('wizardBar');
    var current = 1;

    function loadDraft() {
      // Alur "Ajukan Unit Lain" (?again=1): isi identitas pemilik otomatis, sekali pakai
      try {
        var again = new URLSearchParams(window.location.search).get('again');
        if (again) {
          var rep = JSON.parse(localStorage.getItem('jap_ajukan_repeat_v1') || 'null');
          if (rep && typeof rep === 'object') {
            ['owner_name', 'phone_number', 'address', 'nik', 'ttl', 'bank_name', 'bank_name_other', 'account_number'].forEach(function (name) {
              var el = form.querySelector('[name="' + name + '"]');
              if (el && rep[name]) el.value = rep[name];
            });
            toggleBankOther();
          }
          localStorage.removeItem('jap_ajukan_repeat_v1');
        }
      } catch (e) {}
      var draft = null;
      try { draft = JSON.parse(localStorage.getItem(DRAFT_KEY) || 'null'); } catch (e) { draft = null; }
      if (draft && typeof draft === 'object') {
        TEXT_FIELDS.forEach(function (name) {
          if (draft[name] != null && draft[name] !== '') {
            var el = form.querySelector('[name="' + name + '"]');
            if (!el) return;
            if (el.type === 'radio') {
              var target = form.querySelector('[name="' + name + '"][value="' + draft[name] + '"]');
              if (target) {
                target.checked = true;
                try { target.dispatchEvent(new Event('change', { bubbles: true })); } catch (e) {}
              }
            } else if (!el.value) el.value = draft[name];
          }
        });
        // Kembalikan centangan unit + slot per kolom
        try {
          var du = draft.unit_type;
          var uarr = Array.isArray(du) ? du : (du ? [du] : []);
          if (uarr.length) {
            form.querySelectorAll('input[name="unit_type"]').forEach(function (box) {
              box.checked = uarr.indexOf(box.value) !== -1;
            });
          }
          ['slot_bss', 'slot_evcs'].forEach(function (sn) {
            if (draft[sn] && /^[1-4]$/.test(String(draft[sn]))) {
              var t = form.querySelector('input[name="' + sn + '"][value="' + draft[sn] + '"]');
              if (t) t.checked = true;
            }
          });
        } catch (e) {}
        var statusEl = document.getElementById('locStatus');
        var mapsVal = form.querySelector('[name="maps_link"]').value;
        if (mapsVal && statusEl && statusEl.textContent.indexOf('Belum ada titik') !== -1) {
          statusEl.textContent = '📍 Lokasi tersimpan dari draft: ' + mapsVal;
        }
        var locAddrEl = form.querySelector('[name="location_address"]');
        var locAddrStatus = document.getElementById('locAddrStatus');
        if (locAddrEl && locAddrEl.value.trim() && locAddrStatus) {
          locAddrStatus.textContent = '✓ Alamat lokasi dari tersimpan — boleh diubah manual.';
        }
      }
      try {
        var s = parseInt(localStorage.getItem(STEP_KEY) || '1', 10);
        if (s >= 1 && s <= steps.length) current = s;
      } catch (e) {}
      toggleBankOther();
      try { if (typeof window._japRefreshHarga === 'function') window._japRefreshHarga(); } catch (e) {}
      try { if (typeof window._japRefreshSlot === 'function') window._japRefreshSlot(); } catch (e) {}
      try {
        var latDraft = form.querySelector('[name="lat_long"]');
        if (latDraft && latDraft.value) {
          try { latDraft.dispatchEvent(new Event('input', { bubbles: true })); } catch (e) {}
        } else if (typeof window._japSyncLatFromMaps === 'function') {
          var mv = form.querySelector('[name="maps_link"]');
          if (mv && mv.value) window._japSyncLatFromMaps(mv.value);
        }
      } catch (e) {}
    }

    function saveDraft() {
      var draft = {};
      TEXT_FIELDS.forEach(function (name) {
        var el = form.querySelector('[name="' + name + '"]');
        if (!el) return;
        if (el.type === 'radio') {
          var ch = form.querySelector('[name="' + name + '"]:checked');
          draft[name] = ch ? ch.value : '';
        } else if (el) draft[name] = el.value;
      });
      // Grup multi-pilih: jenis unit (checkbox) + slot per kolom (radio)
      draft.unit_type = Array.prototype.map.call(
        form.querySelectorAll('input[name="unit_type"]:checked'), function (x) { return x.value; });
      ['slot_bss', 'slot_evcs'].forEach(function (sn) {
        var sc = form.querySelector('input[name="' + sn + '"]:checked');
        draft[sn] = sc ? sc.value : '';
      });
      try {
        localStorage.setItem(DRAFT_KEY, JSON.stringify(draft));
        localStorage.setItem(STEP_KEY, String(current));
      } catch (e) {}
    }

    function paint() {
      steps.forEach(function (sec) {
        sec.classList.toggle('active', parseInt(sec.getAttribute('data-step'), 10) === current);
      });
      stepItems.forEach(function (li) {
        var n = parseInt(li.getAttribute('data-step'), 10);
        li.classList.toggle('current', n === current);
        li.classList.toggle('done', n < current);
      });
      if (bar) bar.style.width = (current / steps.length * 100) + '%';
      if (current === 3) {
        if (typeof window._japInvalidateMap === 'function') {
          window._japInvalidateMap();
        }
        // Paksa aktifkan GPS: sekali saja, minta izin lokasi saat masuk tahap 3 bila pin masih kosong
        var mapsVal = form.querySelector('[name="maps_link"]').value;
        if (!mapsVal && !window._japGpsAutoTried) {
          window._japGpsAutoTried = true;
          var btnGps = document.getElementById('btnGps');
          var statusEl = document.getElementById('locStatus');
          if (btnGps && statusEl) {
            statusEl.textContent = '📡 Mengaktifkan GPS — mohon izinkan akses lokasi di browser/HP Anda…';
            setTimeout(function () { try { btnGps.click(); } catch (e) {} }, 400);
          }
        }
      }
      var card = form;
      if (card && card.scrollIntoView) {
        try { card.scrollIntoView({ behavior: 'smooth', block: 'start' }); } catch (e) {}
      }
    }

    function validateStep(n) {
      var sec = form.querySelector('.wizard-step[data-step="' + n + '"]');
      if (!sec) return true;
      // Tahap 2: validasi nama toko + harga dinamis dulu (pola referensi)
      if (n === 2) {
        if (typeof window._japRefreshHarga === 'function') { try { window._japRefreshHarga(); } catch (e) {} }
        if (typeof window._japValidateShop === 'function') {
          if (!window._japValidateShop()) {
            var shopEl = document.getElementById('shop_name');
            if (shopEl) {
              shopEl.reportValidity();
              if (shopEl.scrollIntoView) shopEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
            return false;
          }
        }
        // Multi-unit: minimal satu jenis tercentang + slot terisi per jenisnya
        var picked = [];
        Array.prototype.forEach.call(sec.querySelectorAll('input[name="unit_type"]:checked'), function (x) {
          if (x.value === 'bss_motor' || x.value === 'evcs_mobil') picked.push(x.value);
        });
        if (!picked.length) {
          alert('Pilih minimal satu jenis unit: BSS, EVCS, atau keduanya.');
          var up = document.getElementById('unitPick');
          if (up && up.scrollIntoView) up.scrollIntoView({ behavior: 'smooth', block: 'center' });
          return false;
        }
        var needSlot = { bss_motor: 'slot_bss', evcs_mobil: 'slot_evcs' };
        var labelSlot = { bss_motor: 'Slot BSS 1–4', evcs_mobil: 'Slot EVCS 1–4' };
        for (var si = 0; si < picked.length; si++) {
          var sn = needSlot[picked[si]];
          if (!sec.querySelector('input[name="' + sn + '"]:checked')) {
            alert('Pilih ' + labelSlot[picked[si]] + ' untuk unit yang dicentang.');
            var grid = document.getElementById(picked[si] === 'evcs_mobil' ? 'slotGridEvcs' : 'slotGridBss');
            if (grid && grid.scrollIntoView) grid.scrollIntoView({ behavior: 'smooth', block: 'center' });
            return false;
          }
        }
      }
      // Khusus tahap peta + detail lokasi: pin, koordinat, alamat, kelurahan, jenis & dokumen
      if (n === 3) {
        var mapsVal = form.querySelector('[name="maps_link"]').value;
        if (!mapsVal) {
          var statusEl = document.getElementById('locStatus');
          if (statusEl) statusEl.textContent = '⚠️ Tempatkan pin 📍 di peta atau tekan "Gunakan Posisi Saya" sebelum lanjut.';
          var mapDiv = document.getElementById('locationMap');
          if (mapDiv && mapDiv.scrollIntoView) mapDiv.scrollIntoView({ behavior: 'smooth', block: 'center' });
          return false;
        }
        var latEl = form.querySelector('[name="lat_long"]');
        if (latEl && !latEl.checkValidity()) {
          latEl.reportValidity();
          if (latEl.scrollIntoView) latEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
          return false;
        }
        var locAddr = form.querySelector('[name="location_address"]');
        if (locAddr && !locAddr.checkValidity()) {
          locAddr.reportValidity();
          return false;
        }
        var rest = sec.querySelectorAll('input, select, textarea');
        for (var k = 0; k < rest.length; k++) {
          var rf = rest[k];
          if (rf.type === 'file') continue;
          if (rf.name === 'maps_link' || rf.name === 'lat_long' || rf.name === 'location_address') continue;
          if (!rf.checkValidity()) {
            rf.reportValidity();
            return false;
          }
        }
        return true;
      }
      var fields = sec.querySelectorAll('input, select, textarea');
      for (var i = 0; i < fields.length; i++) {
        var f = fields[i];
        if (f.type === 'file') continue; // file divalidasi di tahap 4 saat submit
        if (!f.checkValidity()) {
          f.reportValidity();
          return false;
        }
      }
      return true;
    }

    form.addEventListener('click', function (e) {
      var next = e.target.closest ? e.target.closest('[data-next]') : null;
      var prev = e.target.closest ? e.target.closest('[data-prev]') : null;
      if (next) {
        if (!validateStep(current)) return;
        saveDraft();
        if (current < steps.length) { current++; paint(); saveDraft(); }
      } else if (prev) {
        saveDraft();
        if (current > 1) { current--; paint(); saveDraft(); }
      }
    });

    // Klik pada nomor tahap: hanya boleh mundur, tidak boleh loncat maju tanpa validasi
    stepItems.forEach(function (li) {
      li.style.cursor = 'pointer';
      li.addEventListener('click', function () {
        var target = parseInt(li.getAttribute('data-step'), 10);
        if (target < current) { current = target; paint(); saveDraft(); }
      });
    });

    // Autosave saat mengetik / mengganti pilihan / peta berubah
    form.addEventListener('input', saveDraft);
    form.addEventListener('change', function (e) {
      saveDraft();
      // Input galeri (.pick-gal-input) dikelola modul grid; abaikan di sini
      if (e.target && e.target.classList && e.target.classList.contains('pick-gal-input')) return;
      // Tampilkan nama berkas yang dipilih (fallback input biasa)
      if (e.target && e.target.type === 'file') {
        var info = document.getElementById(e.target.id + '_picked');
        if (info) {
          if (e.target.files && e.target.files[0]) {
            var f = e.target.files[0];
            info.style.display = 'block';
            info.textContent = '✓ ' + f.name + ' (' + Math.round(f.size / 1024) + ' KB)';
          } else {
            info.style.display = 'none';
            info.textContent = '';
          }
        }
      }
    });

    // maps_link diubah oleh location-map.js secara programatik (tidak memicu event) → pantau berkala ringan.
    // Kolom maps_url tersembunyi: ikut terisi otomatis dari pin agar backend tetap menerima nilai.
    var lastMaps = '';
    setInterval(function () {
      var el = form.querySelector('[name="maps_link"]');
      if (el && el.value !== lastMaps) {
        lastMaps = el.value;
        saveDraft();
        if (typeof window._japSyncLatFromMaps === 'function') {
          try { window._japSyncLatFromMaps(el.value); } catch (e) {}
        }
      }
      var mu = form.querySelector('[name="maps_url"]');
      if (mu && el && el.value && !mu.value) mu.value = el.value;
    }, 1500);

    // Bank "Lainnya" -> tampilkan kolom tulis manual
    function toggleBankOther() {
      var sel = document.getElementById('bank_name');
      var wrap = document.getElementById('bankOtherWrap');
      var other = document.getElementById('bank_name_other');
      if (!sel || !wrap) return;
      var show = sel.value === 'Lainnya';
      wrap.hidden = !show;
      if (other) {
        other.required = show;
        if (!show) other.value = '';
      }
    }
    var bankSel = document.getElementById('bank_name');
    if (bankSel) bankSel.addEventListener('change', function () { toggleBankOther(); saveDraft(); });

    // Tombol tahap 1: isi/timpa alamat PEMILIK dari GPS (geolocation langsung,
    // tidak menggerakkan pin peta Tahap 3 karena alamat pemilik boleh beda dengan titik lahan).
    // Klik eksplisit = selalu timpa isi manual; pengetikan manual tetap bebas kapan saja.
    var btnGpsAddr = document.getElementById('btnGpsAddress');
    if (btnGpsAddr) {
      btnGpsAddr.addEventListener('click', function () {
        var addrStatus = document.getElementById('addrStatus');
        if (!navigator.geolocation) {
          if (addrStatus) addrStatus.textContent = 'Browser/HP tidak mendukung GPS — silakan ketik alamat manual.';
          return;
        }
        if (addrStatus) addrStatus.textContent = '📡 Mengaktifkan GPS — mohon izinkan akses lokasi…';
        navigator.geolocation.getCurrentPosition(function (pos) {
          try { window._japAutofillAddress(pos.coords.latitude, pos.coords.longitude, 'owner', true); } catch (e) {}
        }, function (err) {
          if (addrStatus) addrStatus.textContent = 'GPS ditolak (' + (err.message || 'izin ditolak') + ') — silakan ketik alamat manual atau coba lagi.';
        }, { enableHighAccuracy: true, timeout: 12000, maximumAge: 0 });
      });
    }

    // Submit akhir: validasi semua tahap teks + berkas wajib
    form.addEventListener('submit', function (e) {
      for (var n = 1; n <= 3; n++) {
        if (!validateStep(n)) {
          e.preventDefault();
          current = n;
          paint();
          return;
        }
      }
      var step4 = form.querySelector('.wizard-step[data-step="4"]');
      var files = step4.querySelectorAll('input.pick-real[type="file"]');
      var LABELS = { ktp_file: 'KTP', photo_1_file: 'Foto Sebrang Jalan', photo_3_file: 'Foto Jaringan Listrik', photo_spot_file: 'Foto Penempatan 3/4m', photo_right_file: 'Foto Sudut Kanan', photo_left_file: 'Foto Sudut Kiri', photo_selfie_file: 'Foto Selfie Pemilik', photo_maps_file: 'Screenshot Koordinat', legal_doc_file: 'Dokumen Legalitas', family_doc_file: 'Foto KK / Buku Nikah', sewa_doc_file: 'Surat Sewa', support_doc_file: 'Dokumen Pendukung' };
      var OPTIONAL_FILES = { support_doc_file: 1 };
      for (var i = 0; i < files.length; i++) {
        if (OPTIONAL_FILES[files[i].name]) continue;
        if (!files[i].files || !files[i].files[0]) {
          e.preventDefault();
          current = 4;
          paint();
          var grp = files[i].closest ? files[i].closest('[data-shot-group]') : null;
          if (grp && grp.scrollIntoView) grp.scrollIntoView({ behavior: 'smooth', block: 'center' });
          alert('Wajib: pilih berkas untuk "' + (LABELS[files[i].name] || files[i].name) + '" — via Kamera atau Galeri, lalu klik salah satu di grid.');
          return;
        }
        if (files[i].files[0].size > 5 * 1024 * 1024) {
          e.preventDefault();
          current = 4;
          paint();
          alert('Ukuran berkas melebihi 5 MB: ' + files[i].files[0].name);
          return;
        }
      }
      // Stash identitas pemilik untuk alur "Ajukan Unit Lain" (dipakai bila ?again=1)
      try {
        var repStash = {};
        ['owner_name', 'phone_number', 'address', 'nik', 'ttl', 'bank_name', 'bank_name_other', 'account_number'].forEach(function (name) {
          var el = form.querySelector('[name="' + name + '"]');
          if (el) repStash[name] = el.value;
        });
        localStorage.setItem('jap_ajukan_repeat_v1', JSON.stringify(repStash));
      } catch (e) {}
      // maps_url tersembunyi: pastikan terisi dari pin sebelum kirim
      var muEl = form.querySelector('[name="maps_url"]');
      var mlEl = form.querySelector('[name="maps_link"]');
      if (muEl && mlEl && !muEl.value && mlEl.value) muEl.value = mlEl.value;
      // Mode offline-first: cegah submit bawaan — kirim via fetch bila online,
      // simpan ke antrean HP bila offline/gagal (otomatis terkirim saat online).
      // Draft teks dibiarkan agar jika server mengembalikan galat,
      // user tidak kehilangan isian. Draft dibersihkan di halaman sukses.
      e.preventDefault();
      if (window._japSubmitLahan) { try { window._japSubmitLahan(form); } catch (err) { form.submit(); } }
      else form.submit();
    });

    var clearBtn = document.getElementById('clearDraft');
    if (clearBtn) {
      clearBtn.addEventListener('click', function () {
        if (!confirm('Hapus semua isian draft di browser ini?')) return;
        try { localStorage.removeItem(DRAFT_KEY); localStorage.removeItem(STEP_KEY); } catch (e) {}
        form.reset();
        // Kembalikan referral dari sessionStorage setelah reset
        try {
          var ref = sessionStorage.getItem('jap_ref') || '';
          if (ref) form.querySelector('[name="referral_code"]').value = ref;
        } catch (e) {}
        form.querySelectorAll('.file-picked').forEach(function (el) { el.style.display = 'none'; el.textContent = ''; });
        // Bersihkan grid kamera/galeri
        if (window._japClearShots) { try { window._japClearShots(); } catch (e) {} }
        current = 1;
        paint();
      });
    }

    loadDraft();
    paint();
  })();

</script>
