<%- include('../partials/head', { title: 'Ajukan Lahan - BSS', withMap: true }) %>
<%- include('../partials/navbar') %>
<link rel="stylesheet" href="/css/photo-picker.css" />

<style>
  .wizard { max-width: 560px; margin: 0 auto 18px; }
  .wizard-steps { display: flex; list-style: none; gap: 4px; padding: 0; margin: 0 0 10px; }
  .wizard-steps li { flex: 1; display: flex; align-items: center; gap: 7px; padding: 8px 6px; border-radius: 10px; font-size: .78rem; font-weight: 600; color: var(--muted, #888); background: transparent; border: 1px solid transparent; }
  .wizard-steps li .ws-num { width: 24px; height: 24px; flex: 0 0 24px; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--bg-soft); border: 1px solid var(--card-border); font-size: .78rem; }
  .wizard-steps li.done { color: var(--primary); }
  .wizard-steps li.done .ws-num { background: var(--primary); border-color: var(--primary); color: #fff; }
  .wizard-steps li.current { color: var(--text); background: var(--card); border-color: var(--card-border); }
  .wizard-steps li.current .ws-num { background: var(--primary); border-color: var(--primary); color: #fff; }
  .wizard-progress { height: 6px; border-radius: 99px; background: var(--bg-soft); border: 1px solid var(--card-border); overflow: hidden; }
  .wizard-progress-bar { height: 100%; width: 25%; background: var(--primary); border-radius: 99px; transition: width .25s ease; }
  .wizard-step { display: none; }
  .wizard-step.active { display: block; animation: wizIn .22s ease; }
  @keyframes wizIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  .wizard-nav { display: flex; gap: 10px; margin-top: 20px; }
  .wizard-nav .spacer { flex: 1; }
  .draft-note { font-size: .78rem; color: var(--muted, #888); margin-top: 12px; text-align: center; }
  .draft-note button { background: none; border: none; color: var(--primary); cursor: pointer; font-size: .78rem; text-decoration: underline; padding: 0; }
  /* Status jaringan + antrean offline */
  .netbar, .outbox { max-width: 560px; margin: 0 auto 12px; box-sizing: border-box; border-radius: 12px; font-size: .8rem; }
  .netbar { padding: 9px 14px; border: 1px solid var(--card-border); background: var(--card); }
  .netbar.online { border-color: rgba(34,181,115,.4); }
  .netbar.offline { border-color: rgba(224,82,82,.5); background: rgba(224,82,82,.07); }
  .netbar[hidden], .outbox[hidden] { display: none; }
  .outbox { border: 1px solid var(--card-border); background: var(--card); padding: 10px 12px; display: grid; gap: 8px; }
  .outbox-head { display: flex; align-items: center; gap: 8px; font-size: .8rem; }
  .outbox-list { display: grid; gap: 6px; }
  .outbox-item { display: flex; align-items: center; gap: 8px; font-size: .78rem; background: var(--bg-soft); border: 1px solid var(--card-border); border-radius: 10px; padding: 7px 10px; }
  .outbox-item .grow { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .outbox-del { border: none; background: rgba(0,0,0,.08); border-radius: 50%; width: 24px; height: 24px; cursor: pointer; font-size: .7rem; flex-shrink: 0; }
  /* Pencarian alamat pada peta */
  .map-search-wrap { position: relative; margin-bottom: 8px; }
  .map-suggest { position: absolute; top: 100%; left: 0; right: 0; z-index: 500; background: var(--card); border: 1px solid var(--card-border); border-radius: 10px; margin-top: 4px; box-shadow: var(--shadow); max-height: 220px; overflow-y: auto; }
  .map-suggest[hidden] { display: none; }
  .map-suggest-item { display: block; width: 100%; text-align: left; background: none; border: none; border-bottom: 1px solid var(--card-border); padding: 9px 12px; font-size: .8rem; color: var(--text); cursor: pointer; font-family: inherit; }
  .map-suggest-item:last-child { border-bottom: none; }
  .map-suggest-item:hover { background: var(--bg-soft); }
  /* Banner info di atas form */
  .ajukan-banner { max-width: 560px; margin: 0 auto 18px; }
  .ajukan-banner img { width: 100%; height: auto; display: block; border-radius: 12px; box-shadow: var(--shadow); border: 1px solid var(--card-border); }
  .section .referral-note, .section .alert { max-width: 560px; margin-left: auto; margin-right: auto; box-sizing: border-box; }
  .section .referral-note { flex-wrap: wrap; overflow-wrap: anywhere; }
  .linklike { background: none; border: none; color: var(--primary); cursor: pointer; font-size: inherit; text-decoration: underline; padding: 0; font-family: inherit; }
  /* Pola referensi Japripay System.html */
  .alert-danger { display: none; align-items: flex-start; gap: 8px; margin-top: 8px; padding: 10px 12px; border-radius: 10px; font-size: .78rem; font-weight: 600; color: #b91c1c; background: #fef2f2; border: 1px solid #fecaca; }
  .alert-danger.show { display: flex; }
  .coord-ok { border-color: #10b981 !important; }
  .coord-bad { border-color: #f59e0b !important; }
  .coord-err { border-color: #ef4444 !important; }
  .maps-links-row { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-top: 6px; flex-wrap: wrap; }
  .maps-links-row a { font-size: .72rem; font-weight: 800; text-transform: uppercase; }
  .link-alt { color: #ef4444; }
  .link-tutor { display: inline-flex; align-items: center; gap: 6px; background: #fef2f2; border: 1px solid #fecaca; color: #dc2626; padding: 5px 10px; border-radius: 8px; text-decoration: none; }
  /* Pilihan kartu radio: jenis unit BSS | EVCS + slot 1-4 */
  .unit-pick { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .unit-card { position: relative; display: flex; flex-direction: column; align-items: center; gap: 2px; padding: 14px 8px; border: 2px solid var(--card-border); border-radius: 14px; cursor: pointer; text-align: center; transition: border-color .15s ease, background .15s ease, transform .1s ease; }
  .unit-card:active { transform: scale(.98); }
  .unit-card input { position: absolute; opacity: 0; pointer-events: none; }
  .unit-card .unit-badge { font-size: 1.3rem; font-weight: 800; letter-spacing: 1px; color: var(--text); }
  .unit-card .unit-desc { font-size: .72rem; color: var(--text-muted); }
  .unit-card:has(input:checked) { border-color: var(--primary); background: color-mix(in srgb, var(--primary) 10%, transparent); box-shadow: var(--shadow); }
  .unit-card:has(input:checked) .unit-badge { color: var(--primary); }
  .unit-card:has(input:focus-visible) { outline: 2px solid var(--primary); outline-offset: 2px; }
  .slot-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .slot-col { border: 1px solid var(--card-border); border-radius: 12px; padding: 8px; opacity: .55; transition: opacity .15s ease, border-color .15s ease; }
  .slot-col.active { opacity: 1; border-color: var(--primary); }
  .slot-col-head { font-size: .72rem; font-weight: 800; letter-spacing: 1px; text-align: center; color: var(--text-muted); }
  .slot-col.active .slot-col-head { color: var(--primary); }
  .slot-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin-top: 6px; }
  .slot-card { position: relative; display: block; text-align: center; padding: 9px 4px; border: 1.5px solid var(--card-border); border-radius: 10px; font-size: .76rem; font-weight: 700; cursor: pointer; transition: background .12s ease, color .12s ease; }
  .slot-card input { position: absolute; opacity: 0; pointer-events: none; }
  .slot-card:has(input:checked) { background: var(--primary); border-color: var(--primary); color: #fff; }
  @media (max-width: 560px) {
    .wizard-steps li .ws-label { display: none; }
    .wizard-steps li { justify-content: center; }
  }
</style>

<main>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Langkah Pertama Anda</span>
        <h2>Formulir Pengajuan Lahan</h2>
        <p>Isi data di bawah ini dengan lengkap dan benar.</p>
      </div>

      <% if (typeof referralCode !== 'undefined' && referralCode) { %>
        <div class="referral-note">
          🔗 Pengajuan terhubung dengan kode referral: <strong><%= referralCode %></strong>
        </div>
      <% } %>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <div class="netbar" id="netBar" hidden></div>
      <div class="outbox" id="outboxBar" hidden></div>

      <div class="ajukan-banner">
        <img src="/img/jabodetabek-map.jpg" alt="Sewa Lahan BSS x V-Green Jabodetabek" loading="lazy" decoding="async" />
      </div>

      <form class="form-card" id="ajukanForm" action="/submit-lahan" method="POST" enctype="multipart/form-data" novalidate>
        <input type="hidden" name="referral_code" id="referral_code" value="<%= typeof referralCode !== 'undefined' ? referralCode : '' %>" />

        <!-- Stepper -->
        <div class="wizard">
          <ol class="wizard-steps" id="wizardSteps">
            <li data-step="1"><span class="ws-num">1</span><span class="ws-label">Data Pemilik</span></li>
            <li data-step="2"><span class="ws-num">2</span><span class="ws-label">Detail Lahan</span></li>
            <li data-step="3"><span class="ws-num">3</span><span class="ws-label">Titik Lokasi</span></li>
            <li data-step="4"><span class="ws-num">4</span><span class="ws-label">Berkas</span></li>
          </ol>
          <div class="wizard-progress"><div class="wizard-progress-bar" id="wizardBar"></div></div>
        </div>

        <!-- TAHAP 1: Data pemilik -->
        <section class="wizard-step" data-step="1">
          <div class="form-divider" style="margin-top:0;">Tahap 1 — Data Pemilik</div>
          <div class="form-group">
            <label for="owner_name">Nama Pemilik Lahan</label>
            <input class="form-control" type="text" id="owner_name" name="owner_name" required placeholder="Nama lengkap pemilik" />
          </div>
          <div class="grid-2-form">
            <div class="form-group">
              <label for="nik">No. NIK (16 digit sesuai KTP)</label>
              <input class="form-control numeric-only" type="text" id="nik" name="nik" required inputmode="numeric" maxlength="16" pattern="[0-9]{16}" placeholder="Contoh: 3174xxxxxxxxxxxx" />
            </div>
            <div class="form-group">
              <label for="ttl">Tempat, Tanggal Lahir</label>
              <input class="form-control" type="text" id="ttl" name="ttl" required maxlength="100" placeholder="Contoh: Bali, 12 Jan 1990" />
            </div>
          </div>
          <div class="form-group">
            <label for="phone_number">No. WhatsApp / Telepon</label>
            <div class="input-group">
              <span class="input-group-addon">+62</span>
              <input class="form-control" type="tel" id="phone_number" name="phone_number" required placeholder="8xx xxxx xxxx" />
            </div>
          </div>
          <div class="form-group">
            <label for="surat">Surat (boleh kosong)</label>
            <input class="form-control" type="text" id="surat" name="surat" maxlength="255" placeholder="Contoh: SHM. No. 16866 / PBB-NOP : 089.088.099.168 (boleh kosong)" />
          </div>
          <div class="form-group">
            <label for="address">Alamat Pemilik Lahan</label>
            <input class="form-control" type="text" id="address" name="address" required placeholder="Alamat lengkap pemilik lahan (boleh beda dengan alamat lokasi)" />
            <div class="map-action-row">
              <button type="button" class="btn btn-outline" style="padding:8px 14px;font-size:.85rem;" id="btnGpsAddress">📍 Timpa dari GPS</button>
            </div>
            <div id="addrStatus" class="loc-status muted-text" style="margin-top:8px;">Ketik manual, atau tekan “Timpa dari GPS” untuk mengisi/menimpa otomatis dari lokasi HP.</div>
          </div>
          <div class="form-group">
            <label for="bank_name">Nama Bank</label>
            <select class="form-control" id="bank_name" name="bank_name" required>
              <option value="">Pilih bank…</option>
              <option value="BCA">BCA</option>
              <option value="BRI">BRI</option>
              <option value="Mandiri">Mandiri</option>
              <option value="BNI">BNI</option>
              <option value="BTN">BTN</option>
              <option value="BSI">BSI</option>
              <option value="CIMB Niaga">CIMB Niaga</option>
              <option value="Danamon">Danamon</option>
              <option value="Permata">Permata</option>
              <option value="Panin">Panin</option>
              <option value="OCBC">OCBC</option>
              <option value="Maybank">Maybank</option>
              <option value="Lainnya">Lainnya (tulis manual)</option>
            </select>
          </div>
          <div class="form-group" id="bankOtherWrap" hidden>
            <label for="bank_name_other">Nama Bank Lainnya</label>
            <input class="form-control" type="text" id="bank_name_other" name="bank_name_other" maxlength="100" placeholder="Tulis nama bank" />
          </div>
          <div class="form-group">
            <label for="account_number">No. Rekening</label>
            <input class="form-control" type="text" id="account_number" name="account_number" required inputmode="numeric" maxlength="20" placeholder="6–20 digit angka" />
            <p class="form-hint">Untuk pembayaran sewa/fee. Pastikan atas nama pemilik lahan.</p>
          </div>
          <div class="form-group">
            <label for="area_size">Luas Lahan (m²)</label>
            <input class="form-control" type="number" id="area_size" name="area_size" required min="0" step="any" inputmode="decimal" placeholder="Contoh: 500 atau 250.5" />
            <p class="form-hint">Angka saja, gunakan titik untuk desimal (contoh: 250.5).</p>
          </div>
          <div class="wizard-nav">
            <span class="spacer"></span>
            <button type="button" class="btn btn-primary" data-next>Lanjut →</button>
          </div>
        </section>

        <!-- TAHAP 2: Detail lahan -->
        <section class="wizard-step" data-step="2">
          <div class="form-divider" style="margin-top:0;">Tahap 2 — Detail Lahan</div>
          <div class="form-group">
            <label>Jenis Unit</label>
            <div class="unit-pick" id="unitPick" role="group" aria-label="Jenis Unit">
              <label class="unit-card">
                <input type="checkbox" name="unit_type" value="bss_motor" checked />
                <span class="unit-badge">BSS</span>
                <span class="unit-desc">Motor • min. 1m × 1,5m</span>
              </label>
              <label class="unit-card">
                <input type="checkbox" name="unit_type" value="evcs_mobil" />
                <span class="unit-badge">EVCS</span>
                <span class="unit-desc">Mobil • est. 3m × 6m</span>
              </label>
            </div>
            <p class="form-hint">Boleh pilih <strong>salah satu atau keduanya</strong> sekaligus — tiap jenis unit dibuatkan pengajuan + slot sendiri. Punya 2+ titik? Kirim satu per satu — pilih slot di bawah, lalu klik <strong>＋ Ajukan Unit Lain</strong> di halaman sukses — data pemilik terisi otomatis.</p>
          </div>
          <div class="form-group">
            <label>Slot Unit</label>
            <div class="slot-cols">
              <div class="slot-col" id="slotColBss">
                <div class="slot-col-head">BSS 1–4</div>
                <div class="slot-grid" id="slotGridBss"></div>
              </div>
              <div class="slot-col" id="slotColEvcs">
                <div class="slot-col-head">EVCS 1–4</div>
                <div class="slot-grid" id="slotGridEvcs"></div>
              </div>
            </div>
            <p class="form-hint" id="slotHint">Pilih slot — jenis unit ikut menyesuaikan kolom yang dipilih.</p>
          </div>
          <div class="grid-2-form">
            <div class="form-group">
              <label for="harga_sewa_bss">Harga Sewa BSS (Rp / tahun)</label>
              <input class="form-control numeric-only harga-dual" type="text" id="harga_sewa_bss" name="harga_sewa_bss" maxlength="15" inputmode="numeric" placeholder="Boleh kosong" />
            </div>
            <div class="form-group">
              <label for="harga_sewa_evcs">Harga Sewa EVCS (Rp / tahun)</label>
              <input class="form-control numeric-only harga-dual" type="text" id="harga_sewa_evcs" name="harga_sewa_evcs" maxlength="15" inputmode="numeric" placeholder="Boleh kosong" />
            </div>
          </div>
          <p class="form-hint" id="hargaHint">Keduanya boleh kosong, nantinya diisi oleh admin. Ideal BSS 3-6 jt/thn.</p>
          <div class="form-group">
            <label for="shop_name">Nama Toko</label>
            <input class="form-control" type="text" id="shop_name" name="shop_name" required maxlength="150" placeholder="Nama toko di lokasi" />
            <div id="shopNameAlert" class="alert-danger">
              <span>⚠️ Nama toko tidak boleh mengandung kata "RUMAH" (kecuali "Rumah Makan"), "RMH", atau "RM" (kecuali diikuti nama makanan seperti RM Padang). Juga tidak boleh mengandung kata "PRIBADI".</span>
            </div>
          </div>
          <div class="grid-2-form">
            <div class="form-group">
              <label for="floor_ready">Lantai sudah rata / cor / keramik?</label>
              <select class="form-control" id="floor_ready" name="floor_ready" required>
                <option value="">Pilih…</option>
                <option value="ya">Ya</option>
                <option value="tidak">Tidak</option>
              </select>
            </div>
            <div class="form-group">
              <label for="has_canopy">Ada kanopi / seng?</label>
              <select class="form-control" id="has_canopy" name="has_canopy" required>
                <option value="">Pilih…</option>
                <option value="ya">Ya</option>
                <option value="tidak">Tidak</option>
              </select>
            </div>
          </div>
          <div class="wizard-nav">
            <button type="button" class="btn btn-outline" data-prev>← Kembali</button>
            <span class="spacer"></span>
            <button type="button" class="btn btn-primary" data-next>Lanjut →</button>
          </div>
        </section>

        <!-- TAHAP 3: Titik lokasi -->
        <section class="wizard-step" data-step="3">
          <div class="form-divider" style="margin-top:0;">Tahap 3 — Titik Lokasi</div>
          <div class="form-group">
            <label for="maps_link">Titik Koordinat Google Maps 📍</label>
            <p class="form-hint">Ketik alamat pada kolom pencarian, atau klik <strong>"Gunakan Posisi Saya"</strong> (GPS), atau klik manual pada peta untuk menggeser pin — pin, koordinat, kota &amp; alamat terisi otomatis.</p>
            <label for="input_lat_long" style="margin-top:6px;">Koordinat Lokasi (Latitude, Longitude)</label>
            <input type="text" class="form-control" name="lat_long" id="input_lat_long" required placeholder="Contoh: -6.200000, 106.816666" autocomplete="off" />
            <div class="maps-links-row">
              <p id="error_msg" class="loc-status muted-text" style="margin:0;">* Masukkan angka dipisahkan koma</p>
              
            </div>
            <div class="form-group" style="margin-top:12px;" hidden>
              <input type="url" name="maps_url" id="manual_maps_url" placeholder="Link Google Maps aset (otomatis dari pin)" autocomplete="off" />
            </div>
            <div class="map-toggle-row">
              <button type="button" class="map-toggle-btn active" id="mapLayerOSM">🗺️ Peta</button>
              <button type="button" class="map-toggle-btn" id="mapLayerSat">🛰️ Satelit</button>
            </div>
            <div class="map-search-wrap">
              <input type="text" id="mapSearch" class="form-control" placeholder="🔍 Ketik alamat / patokan… mis. Jl. Sudirman Jakarta" autocomplete="off" />
              <div id="mapSuggest" class="map-suggest" hidden></div>
            </div>
            <div id="locationMap" class="loc-map"></div>
            <div id="locStatus" class="loc-status muted-text">Belum ada titik. Gunakan tombol 📍 di peta atau posisi GPS Anda.</div>
            <div class="map-action-row">
              <button type="button" class="btn btn-outline" style="padding:8px 14px;font-size:.85rem;" id="btnGps">📍 Gunakan Posisi Saya</button>
              <button type="button" class="btn btn-outline" style="padding:8px 14px;font-size:.85rem;" id="btnRecalibrate">🎯 Kalibrasi Alamat</button>
              <button type="button" class="btn btn-outline" style="padding:8px 14px;font-size:.85rem;" id="btnClearMap">🗑️ Hapus Pin</button>
            </div>
            <label for="location_address" style="margin-top:10px;">Alamat Lokasi Lahan 📍</label>
            <p class="form-hint">Bisa sama atau berbeda dengan alamat pemilik di Tahap 1. Terisi otomatis dari pin peta — tetap bisa diubah manual, dan dipakai sebagai alamat pada watermark foto.</p>
            <textarea class="form-control" id="location_address" name="location_address" rows="2" required placeholder="Alamat lengkap titik lahan"></textarea>
            <div id="locAddrStatus" class="loc-status muted-text" style="margin-top:8px;">Pasang pin untuk mengisi alamat lokasi otomatis.</div>
            <input type="hidden" name="maps_link" id="maps_link" />
          </div>

          <div class="form-divider">Detail Lokasi</div>
          <div class="form-group">
            <label for="city">Kabupaten / Kota</label>
            <input class="form-control" list="cities" id="city" name="city" required maxlength="100" placeholder="Pilih/ketik Kab/Kota" autocomplete="off" />
            <datalist id="cities"><option value="Bekasi"></option><option value="Bogor"></option><option value="Depok"></option><option value="Jakarta Barat"></option><option value="Jakarta Pusat"></option><option value="Jakarta Selatan"></option><option value="Jakarta Timur"></option><option value="Jakarta Utara"></option><option value="Kab. Bekasi"></option><option value="Kab. Bogor"></option><option value="Kab. Tangerang"></option><option value="Tangerang"></option><option value="Tangerang Selatan"></option></datalist>
          </div>
          <div class="grid-2-form">
            <div class="form-group">
              <label for="kecamatan">Kecamatan (opsional)</label>
              <input class="form-control" type="text" id="kecamatan" name="kecamatan" maxlength="100" placeholder="Kecamatan (boleh kosong)" autocomplete="off" />
            </div>
            <div class="form-group">
              <label for="district">Kelurahan (opsional)</label>
              <input class="form-control" type="text" id="district" name="district" maxlength="100" placeholder="Kelurahan (boleh kosong)" autocomplete="off" />
            </div>
          </div>
          <p class="form-hint">Kab/kota, kecamatan &amp; kelurahan terisi otomatis dari pin peta — tetap bisa diubah manual.</p>
          <div class="form-group">
            <label for="location_type">Jenis Lokasi</label>
            <select class="form-control" id="location_type" name="location_type" required>
              <option value="">Pilih jenis lokasi…</option>
              <option value="Depan toko / ruko">Depan toko / ruko</option>
              <option value="Minimarket / warung">Minimarket / warung</option>
              <option value="Kafe / laundry / bengkel">Kafe / laundry / bengkel</option>
              <option value="Kantor">Kantor</option>
              <option value="Area parkir">Area parkir</option>
              <option value="Kost-kostan / rumah kost">Kost-kostan / rumah kost</option>
