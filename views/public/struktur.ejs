<%- include('../partials/head', { title: 'Struktur Tim - BSS' }) %>
<%- include('../partials/navbar') %>

<style>
  .org-toolbar { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-bottom: 10px; background: var(--card); border: 1px solid var(--card-border); border-radius: 14px; padding: 10px 12px; }
  .org-toolbar .btn { padding: 8px 14px; font-size: .76rem; }
  .org-toolbar .spacer { flex: 1; }
  .org-zoom-val { font-size: .78rem; font-weight: 800; min-width: 48px; text-align: center; }
  .org-hint { font-size: .74rem; color: var(--text-muted); margin: 0 0 14px; }
  .scope-bar { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-bottom: 12px; background: var(--card); border: 1px solid var(--card-border); border-radius: 14px; padding: 10px 12px; font-size: .78rem; }
  .scope-bar .spacer { flex: 1; }
  .scope-badge { font-size: .68rem; font-weight: 800; letter-spacing: .4px; padding: 4px 12px; border-radius: 999px; background: var(--bg-soft); border: 1px solid var(--card-border); color: var(--primary); white-space: nowrap; }
  .sup-chain { display: grid; gap: 0; margin-bottom: 14px; }
  .sup-node { display: flex; gap: 10px; align-items: center; background: var(--bg-soft); border: 1px solid var(--card-border); border-radius: 12px; padding: 10px 12px; min-width: 0; }
  .sup-arrow { text-align: center; color: var(--muted, #aaa); font-weight: 800; line-height: 1; padding: 3px 0; }
  .org-node.is-me { border: 2px solid var(--primary); box-shadow: var(--shadow); }
  .org-me-tag { font-size: .6rem; font-weight: 800; letter-spacing: .5px; padding: 2px 10px; border-radius: 999px; background: var(--primary); color: #fff; margin-top: 4px; }
  .org-tree li.has-kids > .org-node { cursor: pointer; }
  .org-tree li.has-kids > .org-node:hover { border-color: var(--primary); }
  .org-tree li.collapsed > ul { display: none; }
  .org-fold { display: none; position: absolute; right: 8px; bottom: 8px; background: var(--primary); color: #fff; font-size: .62rem; font-weight: 800; border-radius: 99px; padding: 1px 8px; }
  .org-tree li.collapsed > .org-node .org-fold { display: inline-block; }
</style>

<main>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Flowchart Organisasi</span>
        <h2><%= typeof brandFullName !== 'undefined' ? brandFullName : 'PT KARYA NYATA ANAK BANGSA' %></h2>
        <% var _scope = (typeof scope !== 'undefined' ? scope : 'full'); %>
        <% var _role = (typeof roleLabel !== 'undefined' ? roleLabel : ''); %>
        <% if (_scope === 'personal') { %>
          <p>Jaringan Anda — Anda sebagai puncak, bawahan tersusun bertingkat ke bawah.</p>
        <% } else { %>
          <p>KNAB → Koordinator → Head Marketing → Marketing.</p>
        <% } %>
      </div>

      <div class="scope-bar">
        <span class="scope-badge"><%= _role ? _role + ' · ' : '' %><%= _scope === 'personal' ? 'JARINGAN SAYA' : 'SELURUH TIM' %></span>
        <span class="subtext" style="margin:0;">
          <% if (_scope === 'personal') { %>
            Menampilkan pohon Anda<% if (typeof personalMembers !== 'undefined' && personalMembers) { %> (<%= personalMembers %> anggota)<% } %><% if (typeof selfFound !== 'undefined' && selfFound === false) { %> — akun tak ditemukan di pohon, menampilkan semua.<% } %>
          <% } else { %>
            <% if (_role === 'KOORDINATOR' || _role === 'SUPERADMIN') { %>Menampilkan seluruh tim.<% } else { %>Menampilkan seluruh tim — kartu <strong>★ ANDA</strong> menandai posisi Anda.<% } %>
          <% } %>
        </span>
        <span class="spacer"></span>
        <% if (_scope === 'personal') { %>
          <a href="/struktur?lihat=semua" class="btn btn-outline">🌐 Lihat Semua Tim</a>
        <% } else { %>
          <% if (_role !== 'SUPERADMIN' && _role !== 'KOORDINATOR') { %>
            <a href="/struktur?lihat=jaringan" class="btn btn-outline">👤 Hanya Jaringan Saya</a>
          <% } else { %>
            <a href="/struktur?lihat=jaringan" class="btn btn-outline">👤 Jaringan Saya</a>
          <% } %>
        <% } %>
      </div>

      <% var _sup = (typeof superiors !== 'undefined' ? superiors : []); %>
      <% if (_scope === 'personal' && _sup.length) { %>
        <div class="card" style="margin-bottom:14px;">
          <div class="card-title-row" style="margin-bottom:10px;">
            <h3 style="margin:0;">🏔️ Rantai Atasan</h3>
          </div>
          <div class="sup-chain">
            <% _sup.forEach(function (s) { %>
              <div class="sup-node">
                <div class="net-id" style="min-width:0;flex:1;">
                  <strong><%= s.name %></strong>
                  <span class="subtext"><%= s.role %></span>
                </div>
              </div>
              <div class="sup-arrow">↓</div>
            <% }) %>
            <div class="sup-node" style="border-color:var(--primary);">
              <div class="net-id" style="min-width:0;flex:1;">
                <strong>Anda (puncak pohon di bawah)</strong>
                <span class="subtext"><%= _role %></span>
              </div>
            </div>
          </div>
        </div>
      <% } %>

      <div class="org-counts">
        <div class="org-count"><b><%= counts.coords %></b><span>Koordinator</span></div>
        <div class="org-count"><b><%= counts.heads %></b><span>Head</span></div>
        <div class="org-count"><b><%= counts.marketing %></b><span>Marketing</span></div>
        <div class="org-count"><b><%= counts.units %></b><span>Unit</span></div>
      </div>

      <div class="org-legend">
        <span class="lg-knab">KNAB</span>
        <span class="lg-coord">KOORDINATOR</span>
        <span class="lg-head">HEAD</span>
        <span class="lg-mkt">MARKETING</span>
      </div>

      <div class="org-toolbar">
        <button type="button" class="btn btn-outline" id="orgExpand">➕ Buka Semua</button>
        <button type="button" class="btn btn-outline" id="orgCollapse">➖ Tutup ke Level 1</button>
        <span class="spacer"></span>
        <button type="button" class="btn btn-outline" id="orgZoomOut" aria-label="Perkecil">🔍−</button>
        <span class="org-zoom-val" id="orgZoomVal">100%</span>
        <button type="button" class="btn btn-outline" id="orgZoomIn" aria-label="Perbesar">🔍＋</button>
        <button type="button" class="btn btn-outline" id="orgZoomReset" aria-label="Reset zoom">⤾</button>
      </div>
      <p class="org-hint">💡 Klik kartu untuk membuka/menutup bawahannya · geser ke samping bila pohon lebar.</p>

      <% var _meId = (typeof currentUserId !== 'undefined' ? currentUserId : 0); %>
      <div class="org-scroll">
        <ul class="org-tree" id="pubOrgTree">
          <li>
            <div class="org-node knab">
              <span class="org-avatar org-avatar-logo"><img src="<%= typeof brandLogo !== 'undefined' ? brandLogo : '/img/logo.png' %>" alt="Logo" loading="lazy" onerror="this.remove()" /><b>KN</b></span>
              <strong class="org-name"><%= typeof brandFullName !== 'undefined' ? brandFullName : 'KNAB' %></strong>
              <span class="org-meta">
                <span class="org-role">PUSAT</span>
                <span class="org-stat">Sewa Lahan BSS × V-Green</span>
              </span>
            </div>
            <% if (tree && tree.length) { %>
            <ul>
              <% tree.forEach(function (node) { %>
                <%- include('./_struktur-node', { node: node, currentUserId: _meId }) %>
              <% }) %>
            </ul>
            <% } %>
          </li>
        </ul>
      </div>

      <% if (!tree || !tree.length) { %>
        <p class="text-center" style="color:var(--text-muted);">Belum ada data tim untuk ditampilkan.</p>
      <% } %>
    </div>
  </section>
</main>

<script>
  (function () {
    var tree = document.getElementById('pubOrgTree');
    if (!tree) return;
    function childUl(li) {
      var found = null;
      Array.prototype.forEach.call(li.children, function (ch) {
        if (ch.tagName === 'UL') found = ch;
      });
      return found;
    }
    function nodeOf(li) {
      var found = null;
      Array.prototype.forEach.call(li.children, function (ch) {
        if (ch.classList && ch.classList.contains('org-node')) found = ch;
      });
      return found;
    }
    function hiddenCount(li) {
      return li.querySelectorAll('ul li').length;
    }
    var items = Array.prototype.slice.call(tree.querySelectorAll('li'));
    items.forEach(function (li) {
      if (!childUl(li)) return;
      var node = nodeOf(li);
      if (!node) return;
      li.classList.add('has-kids');
      var chip = document.createElement('span');
      chip.className = 'org-fold';
      node.appendChild(chip);
      var paint = function () {
        chip.textContent = '+' + hiddenCount(li);
      };
      node.addEventListener('click', function () {
        li.classList.toggle('collapsed');
        paint();
      });
      paint();
    });
    function on(id, fn) {
      var b = document.getElementById(id);
      if (b) b.addEventListener('click', fn);
    }
    on('orgExpand', function () {
      items.forEach(function (li) { li.classList.remove('collapsed'); });
    });
    on('orgCollapse', function () {
      items.forEach(function (li) {
        var p = li.parentElement;
        if (p && p.id === 'pubOrgTree') return;
        if (childUl(li)) li.classList.add('collapsed');
      });
    });
    var z = 1;
    var zv = document.getElementById('orgZoomVal');
    function applyZ() {
      tree.style.zoom = z;
      if (zv) zv.textContent = Math.round(z * 100) + '%';
    }
    on('orgZoomIn', function () { z = Math.min(1.6, Math.round((z + 0.1) * 100) / 100); applyZ(); });
    on('orgZoomOut', function () { z = Math.max(0.4, Math.round((z - 0.1) * 100) / 100); applyZ(); });
    on('orgZoomReset', function () { z = 1; applyZ(); });
    (function fit() {
      var sc = tree.closest ? tree.closest('.org-scroll') : null;
      if (!sc) return;
      tree.style.zoom = 1;
      var w = tree.scrollWidth, v = sc.clientWidth;
      if (w > v && w > 0 && v > 0) {
        z = Math.max(0.4, Math.floor((v / w) * 100) / 100);
        applyZ();
      }
    })();
    // Fokus otomatis ke kartu ANDA bila ada.
    try {
      var me = tree.querySelector('.org-node.is-me');
      if (me && me.scrollIntoView) {
        var sc2 = tree.closest ? tree.closest('.org-scroll') : null;
        me.scrollIntoView({ block: 'nearest', inline: 'center' });
        if (sc2) sc2.scrollTop = 0;
      }
    } catch (e) {}
  })();
</script>

<%- include('../partials/foot') %>
