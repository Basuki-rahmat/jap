<%- include('../partials/head', { title: 'Lupa Password - BSS' }) %>
<%- include('../partials/navbar') %>

<main>
  <section class="section">
    <div class="container">
      <div class="form-card" style="max-width:420px;">
        <div class="text-center mb-3">
          <div style="font-size:2.4rem;line-height:1;">🔐</div>
          <h2>Lupa Password</h2>
          <p style="color:var(--text-muted);font-size:.88rem;">Masukkan email akun Anda — kami kirim link reset (berlaku 1 jam).</p>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-error"><%= error %></div>
        <% } %>

        <% if (sent) { %>
          <div class="alert alert-success">📩 Jika email terdaftar, link reset sudah dikirim (cek inbox &amp; spam). Tautan berlaku 1 jam.</div>
          <p class="text-center" style="margin-top:14px;font-size:.86rem;">
            <a href="/login"><strong>← Kembali ke Login</strong></a>
          </p>
        <% } else { %>
          <form action="/lupa-password" method="POST">
            <div class="form-group">
              <label for="email">Email</label>
              <input class="form-control" type="email" id="email" name="email" required placeholder="email@domain.com" />
            </div>
            <button type="submit" class="btn btn-primary btn-block"><strong>Kirim Link Reset</strong></button>
          </form>
          <p class="text-center" style="margin-top:14px;font-size:.86rem;">
            <a href="/login">← Kembali ke Login</a>
          </p>
        <% } %>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/foot') %>
