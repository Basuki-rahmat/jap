<%- include('../partials/head', { title: 'Reset Password - BSS' }) %>
<%- include('../partials/navbar') %>

<main>
  <section class="section">
    <div class="container">
      <div class="form-card" style="max-width:420px;">
        <% if (state === 'done') { %>
          <div class="text-center mb-3">
            <div style="font-size:2.4rem;line-height:1;">✅</div>
            <h2>Password Diganti!</h2>
            <p style="color:var(--text-muted);font-size:.88rem;">Silakan login dengan password baru Anda. Email konfirmasi juga dikirim ke inbox.</p>
          </div>
          <a href="/login" class="btn btn-primary btn-block" style="text-decoration:none;text-align:center;"><strong>Login Sekarang</strong></a>
        <% } else if (state === 'invalid') { %>
          <div class="text-center mb-3">
            <div style="font-size:2.4rem;line-height:1;">❌</div>
            <h2>Tautan Tidak Valid</h2>
            <p style="color:var(--text-muted);font-size:.88rem;">Link reset tidak dikenal, sudah dipakai, atau lewat 1 jam. Silakan minta link baru.</p>
          </div>
          <a href="/lupa-password" class="btn btn-primary btn-block" style="text-decoration:none;text-align:center;"><strong>Minta Link Baru</strong></a>
        <% } else { %>
          <div class="text-center mb-3">
            <div style="font-size:2.4rem;line-height:1;">🔑</div>
            <h2>Buat Password Baru</h2>
            <p style="color:var(--text-muted);font-size:.88rem;">Halo <strong><%= name %></strong> — masukkan password baru Anda.</p>
          </div>
          <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-error"><%= error %></div>
          <% } %>
          <form method="POST">
            <div class="form-group">
              <label for="password">Password Baru (min. 6 karakter)</label>
              <input class="form-control" type="password" id="password" name="password" required minlength="6" autocomplete="new-password" placeholder="••••••••" />
            </div>
            <div class="form-group">
              <label for="confirm_password">Konfirmasi Password Baru</label>
              <input class="form-control" type="password" id="confirm_password" name="confirm_password" required minlength="6" autocomplete="new-password" placeholder="••••••••" />
            </div>
            <button type="submit" class="btn btn-primary btn-block"><strong>Simpan Password Baru</strong></button>
          </form>
        <% } %>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/foot') %>
