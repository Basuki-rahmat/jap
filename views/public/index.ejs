<%- include('../partials/head', { title: 'Beranda - Sewa Lahan BSS' }) %>
<%- include('../partials/navbar') %>

<style>
  .hero-new { position: relative; overflow: hidden; }
  .hero-pill { display: inline-block; font-size: .76rem; font-weight: 800; letter-spacing: 1.5px; text-transform: uppercase; color: var(--accent); background: var(--accent-soft, rgba(0,0,0,.05)); border: 1px solid var(--accent); border-radius: 999px; padding: 6px 16px; margin-bottom: 16px; }
  .hero-new h1 { text-wrap: balance; }
  .hero-new h1 span { background: linear-gradient(90deg, var(--accent), var(--primary)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .hero-steps { display: flex; gap: 8px; list-style: none; padding: 0; margin: 24px 0 0; flex-wrap: wrap; }
  .hero-steps li { display: flex; align-items: center; gap: 8px; font-size: .8rem; font-weight: 600; color: var(--text-muted); background: var(--card); border: 1px solid var(--card-border); border-radius: 999px; padding: 6px 14px 6px 6px; }
  .hero-steps li strong { width: 24px; height: 24px; border-radius: 50%; background: var(--primary); color: #fff; display: inline-flex; align-items: center; justify-content: center; font-size: .75rem; }
  .hero-map { position: relative; transform: none; }
  .hero-map:hover { transform: translateY(-4px); }
  .hero-badge { position: absolute; font-size: .74rem; font-weight: 800; background: var(--card); border: 1px solid var(--card-border); border-radius: 999px; padding: 7px 14px; box-shadow: var(--shadow); animation: heroFloat 4s ease-in-out infinite; }
  .hero-badge-top { top: 22px; left: -14px; }
  .hero-badge-bottom { bottom: 22px; right: -10px; animation-delay: 2s; }
  @keyframes heroFloat { 0%, 100% { translate: 0 0; } 50% { translate: 0 -7px; } }
  @media (max-width: 640px) {
    .hero-badge-top { left: 8px; }
    .hero-badge-bottom { right: 8px; }
    .hero-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin-top: 18px; }
    .hero-steps li { flex-direction: column; text-align: center; gap: 5px; padding: 10px 4px; font-size: .68rem; line-height: 1.3; border-radius: 12px; }
    .hero-steps li strong { width: 22px; height: 22px; font-size: .7rem; }
    /* Kartu peta rapat: full-width, padding kecil, badge di dalam */
    .hero-art { width: 100%; }
    .hero-map { max-width: 100%; padding: 8px; }
    .hero-map img { max-height: none; }
    .hero-map .zoom-hint { margin-top: 4px; }
    .hero-badge { font-size: .66rem; padding: 5px 10px; animation: none; }
    .hero-badge-top { top: 14px; left: 14px; }
    .hero-badge-bottom { bottom: 40px; right: 14px; }
  }
</style>

<main>
  <!-- HERO -->
  <section class="hero hero-new">
    <div class="container hero-inner">
      <div class="hero-text">
        <span class="hero-pill">🔋 Sewa Lahan BSS &times; V-Green</span>
        <h1>LAHAN KECIL <span>Jadi Penghasilan</span> Tahunan</h1>
        <p>
          Ajukan lahan Anda, ikuti proses verifikasi, dan dukung ekosistem kendaraan listrik bersama Sewa Lahan BSS &times; V-Green.
        </p>
        <div class="hero-cta">
          <% if (typeof referralCode !== 'undefined' && referralCode) { %>
          <a href="/ajukan?ref=<%= referralCode %>" class="btn btn-accent"><strong>Mulai dari Sini →</strong></a>
          <% } %>
          <a href="/panduan" class="btn btn-outline">Lihat Panduan</a>
        </div>
        <ol class="hero-steps">
          <li><strong>1</strong> Ajukan lahan</li>
          <li><strong>2</strong> Verifikasi survei</li>
          <li><strong>3</strong> Terima sewa</li>
        </ol>
      </div>

      <div class="hero-art">
        <figure class="hero-img-card hero-map zoomable">
          <img src="/img/jabodetabek-map.jpg" alt="Wilayah prioritas Jabodetabek Sewa Lahan BSS x V-Green" />
          <span class="zoom-hint">Klik untuk zoom</span>
          <span class="hero-badge hero-badge-top">📍 Wilayah Prioritas</span>
          <span class="hero-badge hero-badge-bottom">🔋 BSS &times; V-Green</span>
        </figure>
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Kenapa Sewa Lahan BSS?</span>
        <h2>Fitur Utama</h2>
        <p>Semua yang Anda butuhkan untuk mengelola pengajuan lahan dalam satu platform.</p>
      </div>

      <div class="grid-3">
        <div class="card">
          <img class="feature-img" src="/img/ajukan-lokasi.png" alt="Ajukan lokasi lahan" loading="lazy" decoding="async" />
        </div>
        <div class="card">
            <img class="feature-img" src="/img/verifikasi-admin.png" alt="verifikasi" loading="lazy" decoding="async" />
          </div>
        <div class="card">
            <img class="feature-img" src="/img/fee.png" alt="fee" loading="lazy" decoding="async" />
        </div>
        <div class="card">
            <img class="feature-img" src="/img/rekrut.png" alt="Downline" loading="lazy" decoding="async" />
        </div>
        <div class="card">
          <img class="feature-img" src="/img/referal.png" alt="refferal" loading="lazy" decoding="async" />
        </div>
        <div class="card">
          <img class="feature-img" src="/img/pantau.png" alt="Dashboard" loading="lazy" decoding="async" />
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="container">
      <div class="cta-banner text-center">
        <img class="cta-banner-img" src="/img/pengajuan.png" alt="Pengajuan lahan" loading="lazy" decoding="async" />
        <h2 class="mb-3">Siap Memulai?</h2>
        <p style="max-width:520px;margin:0 auto 26px;">
          Ajukan lahan pertama Anda sekarang dan nikmati keuntungannya.
        </p>
        <% if (typeof referralCode !== 'undefined' && referralCode) { %>
        <a href="/ajukan?ref=<%= referralCode %>" class="btn btn-accent">Mulai Pengajuan</a>
        <% } else { %>
        <a href="/panduan" class="btn btn-accent">Lihat Panduan</a>
        <% } %>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/foot') %>

<div id="zoom-overlay" aria-hidden="true">
  <img id="zoom-img" src="/img/jabodetabek-map.jpg" alt="Wilayah prioritas Jabodetabek" />
  <button id="zoom-close" aria-label="Tutup">&times;</button>
</div>

<script>
  (function () {
    var overlay = document.getElementById('zoom-overlay');
    var img = document.getElementById('zoom-img');
    var closeBtn = document.getElementById('zoom-close');
    document.querySelectorAll('.zoomable img').forEach(function (el) {
      el.addEventListener('click', function () {
        img.src = el.src;
        overlay.classList.add('open');
        overlay.setAttribute('aria-hidden', 'false');
      });
    });
    function close() {
      overlay.classList.remove('open');
      overlay.setAttribute('aria-hidden', 'true');
    }
    closeBtn.addEventListener('click', close);
    overlay.addEventListener('click', function (e) {
      if (e.target === overlay) close();
    });
  })();
</script>