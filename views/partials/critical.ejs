<% /* CSS kritis above-the-fold (disalin dari public/css/style.css, minified). */ %>
<style>@font-face{font-family:"Open Sans";font-style:normal;font-weight:100 900;font-display:swap;src:url("/fonts/open-sans-latin.woff2") format("woff2")}:root{--bg:#f8fafc;--bg-soft:#eef4fa;--card:#fff;--card-border:#dce7f2;--line:#dce7f2;--text:#12345b;--text-muted:#53657a;--primary:#0b4385;--primary-strong:#0b376b;--primary-soft:#e9f1f8;--accent:#c4931c;--accent-strong:#a87b12;--accent-soft:#fdf6e7;--icon-soft:#a87b12;--danger:#dc2626;--success:#16a34a;--warning:#b57f14;--nav-bg:rgba(255,255,255,.92);--footer-bg:#0b376b;--footer-text:#dbe7f3;--footer-muted:#93aec7;--shadow:0 12px 32px rgba(20,45,80,.10);--shadow-sm:0 0 4px rgba(20,45,80,.10);--radius:12px;--radius-sm:8px;--transition:.25s ease}[data-theme="dark"]{--bg:#0b1620;--bg-soft:#0f1f2c;--card:#122532;--card-border:#2293cf;--line:#2293cf;--text:#e7f2f9;--text-muted:#93b6ca;--primary:#38b6f0;--primary-strong:#6cc9f5;--primary-soft:#092c43;--accent:#e48109;--accent-strong:#fb8a00;--accent-soft:#3a2a10;--icon-soft:#3c3310;--danger:#f87171;--success:#4ade80;--warning:#fbbf24;--nav-bg:rgba(11,22,32,.9);--footer-bg:#0a1118;--footer-text:#cfe0ea;--footer-muted:#7f97a8;--shadow:0 10px 28px rgba(0,0,0,.45);--shadow-sm:0 4px 12px rgba(0,0,0,.3)}*{margin:0;padding:0;box-sizing:border-box}html{scroll-behavior:smooth}body{font-family:"Open Sans","Segoe UI",system-ui,-apple-system,Roboto,sans-serif;background:linear-gradient(135deg,#f8fafc 0%,#fff 50%,#eef4fa 100%);color:var(--text);line-height:1.6;display:flex;flex-direction:column;min-height:100vh}[data-theme="dark"] body{background:var(--bg)}main{flex:1}a{color:var(--primary);text-decoration:none}h1,h2,h3{font-family:"Open Sans","Segoe UI",system-ui,sans-serif;font-weight:700}img{max-width:100%;display:block}.container{width:100%;max-width:1140px;margin:0 auto;padding:0 20px}.navbar{position:sticky;top:0;z-index:50;background:var(--nav-bg);backdrop-filter:blur(10px);border-bottom:1px solid var(--card-border)}.navbar::before{content:"";position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--primary),var(--accent))}.navbar-inner{display:flex;align-items:center;justify-content:space-between;height:68px;gap:16px}.nav-start{display:flex;align-items:center;gap:12px;min-width:0}.brand{display:flex;align-items:center;gap:10px;font-weight:700;font-size:1.25rem;color:var(--text);white-space:nowrap}.brand .logo-img{width:38px;height:38px;border-radius:10px;object-fit:contain}.brand .brand-text{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:44vw}@media(min-width:641px){.brand .brand-text{max-width:320px}}.navbar .brand .logo-img,.drawer-head .brand .logo-img,.footer-brand .brand .logo-img{background:#fff;padding:3px;border:1px solid var(--card-border);box-shadow:var(--shadow-sm)}.nav-menu{display:flex;align-items:center;gap:6px;list-style:none}.nav-link{display:inline-block;padding:8px 14px;border-radius:var(--radius-sm);color:var(--text-muted);font-weight:500}.nav-link:hover,.nav-link.active{color:var(--primary-strong);background:var(--primary-soft)}.nav-cta{padding:9px 18px;font-size:.8rem}.nav-actions{display:flex;align-items:center;gap:10px}.theme-toggle{width:44px;height:44px;border-radius:50%;border:1px solid var(--card-border);background:var(--card);color:var(--text);font-size:1.15rem;cursor:pointer;display:grid;place-items:center}.nav-toggle{display:flex;flex-direction:column;justify-content:center;gap:5px;width:36px;height:36px;background:transparent;border:none;cursor:pointer;padding:0;align-items:center}.nav-toggle span{width:20px;height:2.5px;background:var(--text);border-radius:2px}.drawer-backdrop{position:fixed;inset:0;z-index:90;background:rgba(8,15,22,.55);opacity:0;visibility:hidden}.drawer-backdrop.show{opacity:1;visibility:visible}.drawer{position:fixed;top:0;left:0;bottom:0;z-index:100;width:min(330px,86vw);background:var(--bg);border-right:1px solid var(--card-border);display:flex;flex-direction:column;padding:20px;transform:translateX(-100%)}.drawer.open{transform:translateX(0)}.drawer-head{display:flex;align-items:center;justify-content:space-between;padding-bottom:16px;border-bottom:1px solid var(--card-border);margin-bottom:14px}.drawer-close{width:40px;height:40px;border:1px solid var(--card-border);border-radius:50%;background:transparent;color:var(--text);font-size:.95rem;cursor:pointer}.drawer-nav{display:flex;flex-direction:column;gap:4px}.drawer-link{padding:12px 14px;border-radius:10px;font-weight:600;font-size:1.02rem;color:var(--text-muted)}.drawer-link:hover,.drawer-link.active{background:var(--primary-soft);color:var(--primary-strong)}.drawer-footer{margin-top:auto}.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:12px 26px;border-radius:22px;border:1px solid transparent;font-weight:700;font-size:.88rem;letter-spacing:.6px;text-transform:uppercase;cursor:pointer;white-space:nowrap}.btn-accent{background:var(--accent);color:#fff}.btn-outline{background:transparent;border-color:var(--primary);color:var(--primary-strong)}.btn-primary{background:var(--primary);color:#fff}.btn-block{width:100%}.hero{padding:72px 0 64px;background:var(--bg-soft);border-bottom:1px solid var(--card-border)}.hero-inner{display:grid;grid-template-columns:1.05fr .95fr;gap:48px;align-items:center}.hero h1{font-size:clamp(1.9rem,4.5vw,3rem);line-height:1.15;margin-bottom:18px;text-transform:uppercase}.hero p{font-size:1.05rem;color:var(--text-muted);margin-bottom:28px;max-width:460px}.hero-cta{display:flex;gap:14px;flex-wrap:wrap}.hero-art{display:grid;place-items:center}.hero-img-card{margin:0;width:100%;max-width:420px;background:var(--card);border:1px solid var(--card-border);border-radius:var(--radius);padding:12px;box-shadow:var(--shadow)}.hero-img-card img{width:100%;height:auto;max-height:420px;object-fit:cover;border-radius:8px;display:block}.zoom-hint{display:block;text-align:center;font-size:.7rem;color:var(--text-muted);margin-top:6px}.form-card{max-width:560px;margin:0 auto;background:var(--card);border:1px solid var(--card-border);border-radius:var(--radius);padding:32px;box-shadow:var(--shadow)}.form-group{margin-bottom:18px}.form-group label{display:block;font-weight:600;font-size:.9rem;margin-bottom:6px}.form-control{width:100%;padding:12px 14px;border:1px solid var(--card-border);border-radius:var(--radius-sm);background:var(--bg-soft);color:var(--text);font-size:.95rem}.alert{padding:12px 16px;border-radius:var(--radius-sm);margin-bottom:18px;font-size:.9rem}.alert-error{background:rgba(220,38,38,.1);color:var(--danger);border:1px solid var(--danger)}.text-center{text-align:center}.mb-3{margin-bottom:18px}@media(max-width:900px){.nav-menu{display:none}.navbar-inner{height:auto;padding:10px 20px}.hero{padding:52px 0 44px}.hero-inner{grid-template-columns:1fr;gap:32px;text-align:center}.hero p{margin-inline:auto}.hero-cta{justify-content:center}.hero-img-card{max-width:360px}}@media(max-width:640px){.container{padding:0 16px}.navbar-inner{height:60px}.brand{font-size:1.1rem;gap:8px}.brand .logo-img{width:32px;height:32px}.theme-toggle{width:36px;height:36px;font-size:.95rem}.drawer{width:min(290px,80vw);padding:16px}.drawer-link{padding:10px 12px;font-size:.92rem}.hero{padding:32px 0 24px}.hero h1{font-size:1.45rem;line-height:1.25;margin-bottom:12px}.hero p{font-size:.88rem;margin-bottom:20px}.hero-cta{gap:10px}.hero-img-card{max-width:290px;padding:8px}.hero-img-card img{max-height:260px}.form-card{padding:20px 14px}.btn{padding:9px 18px;font-size:.82rem}}@media(max-width:380px){.container{padding:0 12px}.hero h1{font-size:1.28rem}.hero-cta .btn{flex:1;padding:8px 12px;font-size:.78rem}}</style>
