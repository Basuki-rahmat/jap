<div class="notif-bell" id="notifBell">
  <button type="button" class="theme-toggle" id="notifBtn" aria-label="Notifikasi" style="position:relative;">
    🔔
    <span class="notif-badge" id="notifBadge" hidden></span>
  </button>
  <div class="notif-drop" id="notifDrop" hidden>
    <div class="notif-drop-head">
      <strong>Notifikasi</strong>
      <a href="/notifikasi">Lihat semua →</a>
    </div>
    <div id="notifList"></div>
  </div>
</div>

<style>
  .notif-bell { position: relative; }
  #notifBtn { position: relative; }
  .notif-badge {
    position: absolute; top: -5px; right: -5px; min-width: 18px; height: 18px;
    border-radius: 99px; background: #dc2626; color: #fff; font-size: .62rem;
    font-weight: 900; display: inline-flex; align-items: center; justify-content: center;
    padding: 0 5px; pointer-events: none;
  }
  .notif-badge[hidden] { display: none; }
  .notif-drop {
    position: absolute; right: 0; top: calc(100% + 10px); width: min(340px, 86vw);
    max-height: min(60vh, 420px); overflow-y: auto;
    background: var(--card); border: 1px solid var(--card-border); border-radius: 14px;
    box-shadow: var(--shadow); z-index: 999; overflow-x: hidden;
  }
  .notif-drop[hidden] { display: none; }
  /* Mobile: dropdown menempel viewport agar tak off-screen / terpotong */
  @media (max-width: 640px) {
    .notif-drop {
      position: fixed;
      top: 76px;
      left: 12px;
      right: 12px;
      width: auto;
    }
  }
  .notif-drop-head {
    display: flex; align-items: center; justify-content: space-between;
    padding: 10px 14px; border-bottom: 1px solid var(--card-border); font-size: .82rem;
  }
  .notif-drop-head a { font-size: .76rem; font-weight: 800; }
  .notif-drop-item {
    display: block; padding: 10px 14px; border-bottom: 1px solid var(--card-border);
    font-size: .8rem; text-decoration: none !important; color: var(--text) !important;
  }
  .notif-drop-item:last-child { border-bottom: none; }
  .notif-drop-item.unread { background: var(--primary-soft); font-weight: 700; }
  .notif-drop-item small { display: block; color: var(--muted, #888); font-weight: 400; margin-top: 2px; }
  .notif-drop-empty { padding: 16px; text-align: center; font-size: .8rem; color: var(--muted, #888); }
</style>

<script>
  (function () {
    var btn = document.getElementById('notifBtn');
    var badge = document.getElementById('notifBadge');
    var drop = document.getElementById('notifDrop');
    var list = document.getElementById('notifList');
    if (!btn) return;

    function esc(s) { return String(s == null ? '' : s).replace(/</g, '&lt;'); }

    function refreshBadge() {
      fetch('/api/notif/unread').then(function (r) { return r.json(); }).then(function (j) {
        var n = Number(j.count) || 0;
        if (n > 0) {
          badge.hidden = false;
          badge.textContent = n > 99 ? '99+' : n;
        } else {
          badge.hidden = true;
        }
      }).catch(function () {});
    }

    function loadLatest() {
      fetch('/api/notif/latest').then(function (r) { return r.json(); }).then(function (j) {
        var items = (j && j.items) || [];
        if (!items.length) {
          list.innerHTML = '<div class="notif-drop-empty">🔕 Belum ada notifikasi.</div>';
          return;
        }
        list.innerHTML = items.map(function (n) {
          var d = '';
          try { d = new Date(n.created_at).toLocaleString('id-ID', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }); } catch (e) {}
          return '<a class="notif-drop-item' + (Number(n.is_read) === 0 ? ' unread' : '') + '" href="' + esc(n.link || '/notifikasi') + '" data-nid="' + n.id + '">'
            + esc(n.title) + '<small>' + d + '</small></a>';
        }).join('');
        list.querySelectorAll('[data-nid]').forEach(function (a) {
          a.addEventListener('click', function () {
            fetch('/api/notif/read', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id: a.getAttribute('data-nid') }),
            }).catch(function () {});
          });
        });
      }).catch(function () {});
    }

    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      var open = drop.hidden;
      drop.hidden = !open;
      if (open) { loadLatest(); refreshBadge(); }
    });
    document.addEventListener('click', function (e) {
      if (!drop.hidden && !e.target.closest('#notifBell')) drop.hidden = true;
    });

    refreshBadge();
    loadLatest();
    setInterval(refreshBadge, 60000);
  })();
</script>
